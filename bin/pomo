#!/usr/bin/python3
"""pomo — Pomodoro TUI that runs commands when work periods start and end
(default: play/pause mpv through playerctl), sends desktop notifications and
exposes its state to waybar.

Config:  ~/.config/pomo/config.toml  (pomo -L to list profiles, pomo -p NAME)
Hooks:   on_work_start / on_work_end (config) or --on-work-start / --on-work-end (CLI)
Keys:    space = pause/resume, n = next phase, r = reset phase, q = quit
Signals: SIGUSR1 = pause/resume, SIGUSR2 = next phase (used by waybar)
UI language: --lang, $POMO_LANG, `language` in config, then the system locale.
"""
import argparse
import asyncio
import json
import os
import signal
import subprocess
import time
import tomllib
from pathlib import Path

from textual.app import App, ComposeResult
from textual.containers import Center, Middle
from textual.widgets import Digits, Footer, Label, ProgressBar

STATE_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "pomo.json"
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pomo" / "config.toml"
WAYBAR_SIGNAL = 9  # must match "signal" in the waybar module

WORK, SHORT, LONG = "work", "short", "long"
ICONS = {WORK: "🍅", SHORT: "☕", LONG: "🌴"}

# ---------------------------------------------------------------- i18n
# English strings are the keys; add a language by adding a dict here.
TRANSLATIONS = {
    "fr": {
        "Work": "Travail",
        "Short break": "Pause courte",
        "Long break": "Pause longue",
        " (paused)": " (en pause)",
        "Pause/Resume": "Pause/Reprise",
        "Next phase": "Phase suivante",
        "Reset phase": "Reset phase",
        "Quit": "Quitter",
        "Back to work!": "Au travail !",
        "Session {n}/{total} — {minutes} min": "Session {n}/{total} — {minutes} min",
        "{minutes} min break — {done} pomodoro(s) done": "{minutes} min de pause — {done} pomodoro(s) fait(s)",
        "Profile: {name}  ·  ": "Profil : {name}  ·  ",
        "Pomodoros: {done}  ·  cycle {n}/{total}": "Pomodoros : {done}  ·  cycle {n}/{total}",
        "error in {file}: {error}": "erreur dans {file} : {error}",
        "unknown key '{key}' in {where} (expected: {keys})": "clé inconnue « {key} » dans {where} (attendu : {keys})",
        "'{key}' must be an integer > 0 ({where})": "« {key} » doit être un entier > 0 ({where})",
        "'{key}' must be a string ({where})": "« {key} » doit être une chaîne ({where})",
        "profile '{name}'": "le profil « {name} »",
        "profile '{name}' not found (available: {names})": "profil « {name} » introuvable (disponibles : {names})",
        "none": "aucun",
        "must be an integer > 0": "doit être un entier > 0",
        "{file} uses the old French keys (profils, defaut, commandes...): "
        "update it, see config.toml in the project":
            "{file} utilise les anciennes clés françaises (profils, defaut, commandes...) : "
            "mets-le à jour, voir config.toml dans le projet",
        "No profiles ({file})": "Aucun profil ({file})",
        "work {work} min · break {short} min · long break {long} min · {cycles} cycles":
            "travail {work} min · pause {short} min · pause longue {long} min · {cycles} répétitions",
        "start: {start}  ·  end: {end}": "début : {start}  ·  fin : {end}",
        "(nothing)": "(rien)",
        "Pomodoro TUI: runs commands when work starts/ends (mpv by default)":
            "Pomodoro TUI : lance des commandes au début/à la fin du travail (mpv par défaut)",
        "Config: {file}. Precedence: defaults < [hooks] < profile < CLI options. "
        "Hooks receive POMO_EVENT (start|resume|end|pause|quit), POMO_PROFILE, "
        "POMO_DONE, POMO_CYCLES, POMO_WORK_MIN.":
            "Config : {file}. Priorité : défauts < [hooks] < profil < options CLI. "
            "Les commandes reçoivent POMO_EVENT (start|resume|end|pause|quit), POMO_PROFILE, "
            "POMO_DONE, POMO_CYCLES, POMO_WORK_MIN.",
        "profile to use (default: default_profile from the config file)":
            "profil à utiliser (défaut : default_profile du fichier de config)",
        "list profiles and exit": "lister les profils et quitter",
        "work minutes ({default})": "minutes de travail ({default})",
        "short break minutes ({default})": "minutes de pause courte ({default})",
        "long break minutes ({default})": "minutes de pause longue ({default})",
        "work sessions before the long break ({default})": "répétitions avant la pause longue ({default})",
        "command run when work starts (\"{default}\")": "commande au début du travail (« {default} »)",
        "command run when work ends (\"{default}\")": "commande à la fin du travail (« {default} »)",
        "do not run any hook": "ne lancer aucune commande",
        "UI language: {langs} (default: auto)": "langue de l'interface : {langs} (défaut : auto)",
    },
}
LANGUAGES = ("en", *TRANSLATIONS)
lang = "en"


def _(text: str, **kwargs) -> str:
    text = TRANSLATIONS.get(lang, {}).get(text, text)
    return text.format(**kwargs) if kwargs else text


def resolve_language(*candidates: str | None) -> str:
    """First explicit candidate wins; 'auto' or None falls through to the locale."""
    for c in candidates:
        if c and c != "auto":
            return c if c in LANGUAGES else "en"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        code = os.environ.get(var, "")[:2]
        if code:
            return code if code in LANGUAGES else "en"
    return "en"


def fail(message: str) -> None:
    raise SystemExit(f"pomo: {message}")


# ---------------------------------------------------------------- helpers
def sh(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def run_hook(cmd: str, env: dict[str, str]) -> None:
    """Run a user shell command without blocking the TUI."""
    if not cmd.strip():
        return
    try:
        subprocess.Popen(
            ["sh", "-c", cmd], env={**os.environ, **env}, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def notify(title: str, body: str, icon: str, urgency: str = "normal") -> None:
    subprocess.Popen(
        ["notify-send", "-a", "pomo", "-u", urgency, "-i", icon,
         "-h", "string:x-canonical-private-synchronous:pomo", title, body],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def refresh_waybar() -> None:
    sh("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


def phase_label(phase: str) -> str:
    return _({WORK: "Work", SHORT: "Short break", LONG: "Long break"}[phase])


# ---------------------------------------------------------------- TUI
class Pomo(App):
    CSS = """
    Screen { align: center middle; }
    #phase { text-style: bold; margin-bottom: 1; width: auto; }
    Digits { width: auto; }
    ProgressBar { margin-top: 1; }
    #info { color: $text-muted; margin-top: 1; width: auto; }
    .work #phase { color: $error; }
    .short #phase, .long #phase { color: $success; }
    .paused Digits { color: $text-disabled; }
    """

    def __init__(self, args: argparse.Namespace) -> None:
        super().__init__()
        self.durations = {WORK: args.work * 60, SHORT: args.short_break * 60, LONG: args.long_break * 60}
        self.cycles = args.cycles
        self.hooks = {} if args.no_hooks else {"start": args.on_work_start, "end": args.on_work_end}
        self.profile = args.profile
        self.phase = WORK
        self.done_pomodoros = 0
        self.remaining = float(self.durations[WORK])
        self.running = False
        self.started = False  # the first "space" is a start, not a resume
        self.last_tick = time.monotonic()

    def compose(self) -> ComposeResult:
        with Middle():
            with Center():
                yield Label(id="phase")
            with Center():
                yield Digits(id="clock")
            with Center():
                yield ProgressBar(show_eta=False, show_percentage=False, id="bar")
            with Center():
                yield Label(id="info")
        yield Footer()

    def on_mount(self) -> None:
        self.title = "pomo"
        # bound at runtime so descriptions use the resolved language
        self.bind("space", "toggle", description=_("Pause/Resume"))
        self.bind("n", "skip", description=_("Next phase"))
        self.bind("r", "reset", description=_("Reset phase"))
        self.bind("q", "quit", description=_("Quit"))
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGUSR1, self.action_toggle)
        loop.add_signal_handler(signal.SIGUSR2, self.action_skip)
        self.set_interval(0.25, self.tick)
        self.render_state()  # wait for "space" to start

    # ---- logic ---------------------------------------------------------
    def start_phase(self, phase: str, announce: bool = True) -> None:
        leaving_work = self.phase == WORK and self.running
        self.phase = phase
        self.remaining = float(self.durations[phase])
        self.running = True
        self.started = True
        self.last_tick = time.monotonic()
        if phase == WORK:
            self.hook("start", "start")
        elif leaving_work:
            self.hook("end", "end")
        if announce:
            if phase == WORK:
                notify(f"{ICONS[WORK]} {_('Back to work!')}",
                       _("Session {n}/{total} — {minutes} min", n=self.done_pomodoros % self.cycles + 1,
                         total=self.cycles, minutes=self.durations[WORK] // 60),
                       "appointment-soon", "critical")
            else:
                notify(f"{ICONS[phase]} {phase_label(phase)}",
                       _("{minutes} min break — {done} pomodoro(s) done",
                         minutes=self.durations[phase] // 60, done=self.done_pomodoros),
                       "face-smile", "critical")
        self.render_state()

    def next_phase(self) -> None:
        if self.phase == WORK:
            self.done_pomodoros += 1
            nxt = LONG if self.done_pomodoros % self.cycles == 0 else SHORT
        else:
            nxt = WORK
        self.start_phase(nxt)

    def tick(self) -> None:
        now = time.monotonic()
        if self.running:
            self.remaining -= now - self.last_tick
            if self.remaining <= 0:
                self.next_phase()
                return
        self.last_tick = now
        self.render_state()

    # ---- actions -------------------------------------------------------
    def action_toggle(self) -> None:
        self.running = not self.running
        self.last_tick = time.monotonic()
        if self.phase == WORK:
            if self.running:
                self.hook("start", "resume" if self.started else "start")
            else:
                self.hook("end", "pause")
        self.started = True
        self.render_state()

    def action_skip(self) -> None:
        self.next_phase()

    def action_reset(self) -> None:
        self.remaining = float(self.durations[self.phase])
        self.render_state()

    async def action_quit(self) -> None:
        if self.phase == WORK and self.running:
            self.hook("end", "quit")
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()
        self.exit()

    def hook(self, which: str, event: str) -> None:
        """which: start|end; event: start|resume (start) or end|pause|quit (end)."""
        run_hook(self.hooks.get(which, ""), {
            "POMO_EVENT": event, "POMO_PROFILE": self.profile or "",
            "POMO_DONE": str(self.done_pomodoros), "POMO_CYCLES": str(self.cycles),
            "POMO_WORK_MIN": str(self.durations[WORK] // 60),
        })

    # ---- display -------------------------------------------------------
    def render_state(self) -> None:
        secs = max(0, int(self.remaining + 0.999))
        mm, ss = divmod(secs, 60)
        total = self.durations[self.phase]
        self.screen.set_classes([self.phase] + ([] if self.running else ["paused"]))
        state = "" if self.running else _(" (paused)")
        self.query_one("#phase", Label).update(f"{ICONS[self.phase]}  {phase_label(self.phase)}{state}")
        self.query_one("#clock", Digits).update(f"{mm:02d}:{ss:02d}")
        self.query_one("#bar", ProgressBar).update(total=total, progress=total - secs)
        self.query_one("#info", Label).update(
            (_("Profile: {name}  ·  ", name=self.profile) if self.profile else "")
            + _("Pomodoros: {done}  ·  cycle {n}/{total}", done=self.done_pomodoros,
                n=self.done_pomodoros % self.cycles + 1, total=self.cycles)
        )
        self.write_state(secs, total)

    def write_state(self, secs: int, total: int) -> None:
        data = {
            "pid": os.getpid(), "phase": self.phase, "running": self.running,
            "remaining": secs, "total": total, "done": self.done_pomodoros, "lang": lang,
            # end timestamp: waybar can count down without waiting for the TUI
            "ends_at": time.time() + secs if self.running else None,
        }
        old = getattr(self, "_last_state", None)
        if old != (self.phase, self.running, self.done_pomodoros, secs):
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(data))
            tmp.replace(STATE_FILE)
            if old is None or old[:3] != (self.phase, self.running, self.done_pomodoros):
                refresh_waybar()
            self._last_state = (self.phase, self.running, self.done_pomodoros, secs)


# ---------------------------------------------------------------- config
DEFAULTS = {
    "work": 25, "short_break": 5, "long_break": 15, "cycles": 4,
    "on_work_start": "playerctl -a -p mpv play",
    "on_work_end": "playerctl -a -p mpv pause",
}
INT_KEYS = ("work", "short_break", "long_break", "cycles")
HOOK_KEYS = ("on_work_start", "on_work_end")
LEGACY_KEYS = ("profils", "defaut", "commandes")


def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    try:
        with CONFIG_FILE.open("rb") as f:
            cfg = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        fail(_("error in {file}: {error}", file=CONFIG_FILE, error=e))
    if any(k in cfg for k in LEGACY_KEYS):
        fail(_("{file} uses the old French keys (profils, defaut, commandes...): "
               "update it, see config.toml in the project", file=CONFIG_FILE))
    return cfg


def parse_values(table: dict, where: str, allowed: tuple[str, ...]) -> dict:
    for key, val in table.items():
        if key not in allowed:
            fail(_("unknown key '{key}' in {where} (expected: {keys})",
                   key=key, where=where, keys=", ".join(allowed)))
        if key in INT_KEYS and (not isinstance(val, int) or isinstance(val, bool) or val <= 0):
            fail(_("'{key}' must be an integer > 0 ({where})", key=key, where=where))
        if key in HOOK_KEYS and not isinstance(val, str):
            fail(_("'{key}' must be a string ({where})", key=key, where=where))
    return dict(table)


def profile_values(profiles: dict, name: str) -> dict:
    if name not in profiles:
        fail(_("profile '{name}' not found (available: {names})",
               name=name, names=", ".join(profiles) or _("none")))
    return parse_values(profiles[name], _("profile '{name}'", name=name), INT_KEYS + HOOK_KEYS)


def positive_int(v: str) -> int:
    n = int(v)
    if n <= 0:
        raise argparse.ArgumentTypeError(_("must be an integer > 0"))
    return n


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description=_("Pomodoro TUI: runs commands when work starts/ends (mpv by default)"),
        epilog=_("Config: {file}. Precedence: defaults < [hooks] < profile < CLI options. "
                 "Hooks receive POMO_EVENT (start|resume|end|pause|quit), POMO_PROFILE, "
                 "POMO_DONE, POMO_CYCLES, POMO_WORK_MIN.", file=CONFIG_FILE),
    )
    ap.add_argument("-p", "--profile", help=_("profile to use (default: default_profile from the config file)"))
    ap.add_argument("-L", "--list", action="store_true", help=_("list profiles and exit"))
    ap.add_argument("-w", "--work", type=positive_int, help=_("work minutes ({default})", default=DEFAULTS["work"]))
    ap.add_argument("-s", "--short-break", type=positive_int,
                    help=_("short break minutes ({default})", default=DEFAULTS["short_break"]))
    ap.add_argument("-l", "--long-break", type=positive_int,
                    help=_("long break minutes ({default})", default=DEFAULTS["long_break"]))
    ap.add_argument("-c", "--cycles", type=positive_int,
                    help=_("work sessions before the long break ({default})", default=DEFAULTS["cycles"]))
    ap.add_argument("--on-work-start", metavar="CMD",
                    help=_("command run when work starts (\"{default}\")", default=DEFAULTS["on_work_start"]))
    ap.add_argument("--on-work-end", metavar="CMD",
                    help=_("command run when work ends (\"{default}\")", default=DEFAULTS["on_work_end"]))
    ap.add_argument("--no-hooks", action="store_true", help=_("do not run any hook"))
    ap.add_argument("--lang", choices=("auto", *LANGUAGES),
                    help=_("UI language: {langs} (default: auto)", langs=", ".join(LANGUAGES)))
    return ap


def main() -> None:
    global lang
    # The language must be known before building translated help texts.
    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--lang")
    cli_lang = pre.parse_known_args()[0].lang
    lang = resolve_language(cli_lang, os.environ.get("POMO_LANG"))
    cfg = load_config()
    lang = resolve_language(cli_lang, os.environ.get("POMO_LANG"), cfg.get("language"))

    args = build_parser().parse_args()
    profiles, default_profile = cfg.get("profiles", {}), cfg.get("default_profile")
    base = {**DEFAULTS, **parse_values(cfg.get("hooks", {}), "[hooks]", HOOK_KEYS)}

    if args.list:
        if not profiles:
            print(_("No profiles ({file})", file=CONFIG_FILE))
        for name in profiles:
            v = {**base, **profile_values(profiles, name)}
            mark = "*" if name == default_profile else " "
            print(f"{mark} {name:<12} " + _(
                "work {work} min · break {short} min · long break {long} min · {cycles} cycles",
                work=v["work"], short=v["short_break"], long=v["long_break"], cycles=v["cycles"]))
            print(f"  {'':<12} " + _("start: {start}  ·  end: {end}",
                                     start=v["on_work_start"] or _("(nothing)"),
                                     end=v["on_work_end"] or _("(nothing)")))
        return

    name = args.profile or default_profile
    settings = dict(base)
    if name:
        settings.update(profile_values(profiles, name))
    for key in DEFAULTS:  # explicit CLI options win
        if getattr(args, key) is not None:
            settings[key] = getattr(args, key)

    try:
        Pomo(argparse.Namespace(**settings, no_hooks=args.no_hooks, profile=name)).run()
    finally:
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()


if __name__ == "__main__":
    main()
