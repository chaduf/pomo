#!/usr/bin/python3
"""pomo — Pomodoro TUI that runs commands when work periods start and end
(default: pause/resume the media players that are playing, through pomo-media),
sends desktop notifications and
exposes its state to waybar. Also has a stopwatch mode with laps.

Config:  ~/.config/pomo/config.toml  (pomo -L to list profiles, pomo -p NAME)
Hooks:   on_work_start / on_work_end (config) or --on-work-start / --on-work-end (CLI)
Keys:    space = pause/resume, n = next phase, + / - = add / remove 5 min to the phase
         (- ends the phase when 5 min or less remain), > / < = add / remove a work session
         to the cycle, r = reset,
         p = switch profile, c = enable / disable the hooks, h / ? / F1 = help,
         m = pomodoro/stopwatch mode, l = lap (stopwatch), q = quit
Signals: SIGUSR1 = pause/resume, SIGUSR2 = next phase or lap (used by waybar)
UI language: --lang, $POMO_LANG, `language` in config, then the system locale.
Sessions: at the end of each cycle, pomo asks for a title and description and logs the
          work time entries to ~/.local/share/pomo/sessions.jsonl;
          pomo --export-ics [FILE] turns them into an iCalendar file (Google Calendar...).
"""
import argparse
import asyncio
import json
import os
import re
import signal
import subprocess
import sys
import time
import tomllib
import uuid
from collections.abc import Callable
from dataclasses import dataclass
from datetime import date, datetime, timezone
from pathlib import Path

from rich.cells import cell_len
from rich.text import Text
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Center, Horizontal, Middle, Vertical
from textual.screen import ModalScreen
from textual.widgets import (Button, DataTable, Digits, Input, Label, OptionList, ProgressBar, Static,
                             TextArea)
from textual.widgets.option_list import Option

STATE_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "pomo.json"
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pomo" / "config.toml"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")) / "pomo"
SESSIONS_FILE = DATA_DIR / "sessions.jsonl"
MIN_ENTRY_SECONDS = 5 * 60  # work time entries shorter than this are not recorded
SNAPSHOT_EVERY = 30         # seconds between saves of the unrecorded work (crash recovery)
WAYBAR_SIGNAL = 9  # must match "signal" in the waybar module
EXTEND_MINUTES = 5  # added to / removed from the current pomodoro phase by the + / - keys

POMODORO, STOPWATCH = "pomodoro", "stopwatch"
WORK, SHORT, LONG = "work", "short", "long"
ICONS = {WORK: "🍅", SHORT: "☕", LONG: "🌴", STOPWATCH: "⏱"}

