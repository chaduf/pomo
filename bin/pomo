LANGUAGES = ("en", *TRANSLATIONS)
lang = "en"


def _(text: str, **kwargs) -> str:
    text = TRANSLATIONS.get(lang, {}).get(text, text)
    return text.format(**kwargs) if kwargs else text


def resolve_language(*candidates: str | None) -> str:
    """First explicit candidate wins; 'auto' or None falls through to the locale."""
    for c in candidates:
        if c and c != "auto":
            return c if c in LANGUAGES else "en"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        code = os.environ.get(var, "")[:2]
        if code:
            return code if code in LANGUAGES else "en"
    return "en"


class ConfigError(Exception):
    """Invalid config: fatal at startup, shown as an in-app error when switching profiles."""


def fail(message: str) -> None:
    raise SystemExit(f"pomo: {message}")


# ---------------------------------------------------------------- helpers
def sh(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


# Directory holding pomo (and pomo-media). Prepended to the hooks' PATH because launchers
# (rofi, app menus) often run pomo without ~/.local/bin in PATH.
BIN_DIR = str(Path(__file__).resolve().parent)


def run_hook(cmd: str, env: dict[str, str]) -> None:
    """Run a user shell command without blocking the TUI."""
    if not cmd.strip():
        return
    path = os.pathsep.join([BIN_DIR, os.environ.get("PATH", "")])
    try:
        subprocess.Popen(
            ["sh", "-c", cmd], env={**os.environ, **env, "PATH": path}, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def notify(title: str, body: str, icon: str, urgency: str = "normal") -> None:
    subprocess.Popen(
        ["notify-send", "-a", "pomo", "-u", urgency, "-i", icon,
         "-h", "string:x-canonical-private-synchronous:pomo", title, body],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def refresh_waybar() -> None:
    sh("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


def format_elapsed(seconds: float) -> str:
    """MM:SS.d below one hour, H:MM:SS.d above."""
    tenths = int(seconds * 10)
    h, rest = divmod(tenths, 36000)
    m, rest = divmod(rest, 600)
    sec, d = divmod(rest, 10)
    return f"{h}:{m:02d}:{sec:02d}.{d}" if h else f"{m:02d}:{sec:02d}.{d}"


def monotonic() -> float:
    return time.monotonic()


def phase_label(phase: str) -> str:
    return _({WORK: "Work", SHORT: "Short break", LONG: "Long break"}[phase])


# ---------------------------------------------------------------- session log
# A "segment" is a stretch of actual work: {"work": <work number in the cycle>, "start": ts, "end": ts}.
# Segments are collected during a cycle and recorded as time entries once the user names them.
def snapshot_file(pid: int | None = None) -> Path:
    return DATA_DIR / f"current-{pid or os.getpid()}.json"


def keep_entries(segments: list[dict]) -> list[dict]:
    return [s for s in segments if s["end"] - s["start"] >= MIN_ENTRY_SECONDS]


def entry_names(title: str, segments: list[dict]) -> list[str]:
    """One entry: the title. Several: <title>_work_<n>, plus .<k> when a work was split by pauses."""
    if len(segments) == 1:
        return [title]
    per_work: dict[int, int] = {}
    for seg in segments:
        per_work[seg["work"]] = per_work.get(seg["work"], 0) + 1
    names, seen = [], {}
    for seg in segments:
        n = seg["work"]
        seen[n] = seen.get(n, 0) + 1
        names.append(f"{title}_work_{n}" + (f".{seen[n]}" if per_work[n] > 1 else ""))
    return names


def record_entries(segments: list[dict], title: str, description: str, profile: str) -> list[dict]:
    entries = [{"id": uuid.uuid4().hex, "start": seg["start"], "end": seg["end"], "title": name,
                "description": description, "profile": profile}
               for seg, name in zip(segments, entry_names(title, segments))]
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with SESSIONS_FILE.open("a") as f:
        f.writelines(json.dumps(e) + "\n" for e in entries)
    return entries


def ics_path(ics_dir: str, title: str, start: float) -> Path:
    """<ics_dir>/YYYY-MM-DD_HHMM_<title>.ics, with a numeric suffix if the name is taken."""
    slug = re.sub(r"[^\w.-]+", "_", title).strip("_.")[:60] or "pomo"
    base = Path(ics_dir).expanduser() / f"{datetime.fromtimestamp(start):%Y-%m-%d_%H%M}_{slug}"
    path, n = base.with_suffix(".ics"), 1
    while path.exists():
        n += 1
        path = Path(f"{base}-{n}.ics")
    return path


def write_cycle_ics(entries: list[dict], ics_dir: str, title: str) -> Path:
    path = ics_path(ics_dir, title, entries[0]["start"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(build_ics(entries), newline="")
    return path


def recover_snapshots() -> list[tuple[list[dict], str, str | None]]:
    """Collect the unrecorded work (segments, profile, ics_dir) left by pomo instances no longer running."""
    recovered = []
    for snap in DATA_DIR.glob("current-*.json"):
        try:
            pid = int(snap.stem.split("-", 1)[1])
            if pid != os.getpid():
                os.kill(pid, 0)
                continue  # that pomo is still running
        except ProcessLookupError:
            pass
        except (ValueError, PermissionError):
            continue
        try:
            data = json.loads(snap.read_text())
            cycle = list(data.get("cycle", []))
            if data.get("segment"):
                cycle.append({**data["segment"], "end": data["last_seen"]})
            recovered += [(kept, data.get("profile", ""), data.get("ics_dir"))
                          for segs in [*data.get("pending", []), cycle]
                          if (kept := keep_entries(segs))]
        except (OSError, ValueError, KeyError):
            pass
        snap.unlink(missing_ok=True)
    return recovered


def read_sessions() -> list[dict]:
    if not SESSIONS_FILE.exists():
        return []
    sessions = []
    for line in SESSIONS_FILE.read_text().splitlines():
        try:
            entry = json.loads(line)
            if "title" in entry:  # skip anything that is not a recorded time entry
                sessions.append(entry)
        except ValueError:
            pass  # a truncated line must not break the export
    return sessions


def ics_escape(text: str) -> str:
    return (text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\n", "\\n"))


def ics_fold(line: str) -> str:
    """Fold a content line at 75 octets (RFC 5545) without splitting UTF-8 characters."""
    out, current, size = [], "", 0
    for char in line:
        n = len(char.encode())
        if size + n > 75:
            out.append(current)
            current, size = " ", 1  # continuation lines start with a space
        current += char
        size += n
    out.append(current)
    return "\r\n".join(out)


def ics_time(ts: float) -> str:
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def build_ics(entries: list[dict]) -> str:
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//pomo//EN", "CALSCALE:GREGORIAN",
             "METHOD:PUBLISH", "X-WR-CALNAME:Pomodoro"]
    stamp = ics_time(time.time())
    for e in entries:
        lines += ["BEGIN:VEVENT",
                  f"UID:{e['id']}@pomo",  # stable: re-importing updates instead of duplicating
                  f"DTSTAMP:{stamp}",
                  f"DTSTART:{ics_time(e['start'])}",
                  f"DTEND:{ics_time(e['end'])}",
                  f"SUMMARY:{ics_escape(e['title'])}"]
        if e.get("description"):
            lines.append(f"DESCRIPTION:{ics_escape(e['description'])}")
        lines += ["CATEGORIES:Pomodoro", "END:VEVENT"]
    lines.append("END:VCALENDAR")
    return "".join(ics_fold(line) + "\r\n" for line in lines)


def export_ics(target: str, since: date | None, until: date | None) -> None:
    def day(s: dict) -> date:
        return datetime.fromtimestamp(s["start"]).date()
    sessions = [s for s in read_sessions()
                if (since is None or day(s) >= since) and (until is None or day(s) <= until)]
    if not sessions:
        fail(_("no time entry to export ({file})", file=SESSIONS_FILE))
    ics = build_ics(sorted(sessions, key=lambda s: s["start"]))
    if target == "-":
        sys.stdout.write(ics)
    else:
        Path(target).write_text(ics, newline="")
        print(_("{n} time entry(ies) exported to {file}", n=len(sessions), file=target))


# ---------------------------------------------------------------- modes
# A mode (pomodoro or stopwatch) holds the timer logic, without any Textual or system call;
# the App delegates to the current mode instead of testing which mode it is.
@dataclass
class View:
    """What the main screen shows for a mode; the App turns it into widgets."""
    classes: list[str]                            # screen CSS classes (phase, paused...)
    title: str                                    # phase line, e.g. "🍅  Work (paused)"
    clock: str
    info: str
    progress: tuple[float, float] | None = None  # (done, total) for the progress bar; None hides it
    laps: list[tuple[str, str, str, str]] | None = None  # lap table rows; None hides the table


class TimerMode:
    """Interface shared by the modes. `clock` returns the current monotonic time."""

    name = ""
    uses_hooks = False     # the work start / end hooks (c toggles them) apply to this mode
    uses_profiles = False  # p switches profile in this mode

    def __init__(self, clock: Callable[[], float]) -> None:
        self.clock = clock
        self.running = False
        # mode specific actions (action name -> method), on top of toggle / skip / reset
        self.actions: dict[str, Callable[[], None]] = {}

    @property
    def idle(self) -> bool:
        """Not started yet: the space key starts rather than resumes."""
        raise NotImplementedError

    def tick(self) -> None:
        raise NotImplementedError

    def toggle(self) -> None:
        raise NotImplementedError

    def skip(self) -> None:
        """n in the TUI, right click in waybar."""
        raise NotImplementedError

    def reset(self) -> None:
        raise NotImplementedError

    def interrupt(self, reason: str) -> list[dict]:
        """Stop before a reset, a profile or mode switch or quitting (reason: reset|switch|quit);
        return the work segments of the current cycle that may be recorded."""
        return []

    def unrecorded(self) -> tuple[dict | None, list[dict]]:
        """(open work segment, finished segments of the cycle), saved against crashes."""
        return None, []

    def view(self) -> View:
        raise NotImplementedError

    def waybar_state(self, wall_time: float) -> tuple[dict, tuple, int]:
        """(state written for waybar, key whose change signals waybar, displayed second)."""
        raise NotImplementedError

    def hints(self) -> list[tuple[str, str, str]]:
        """Footer hints of the mode, as (key, action, label), between space and r."""
        raise NotImplementedError

    def help_rows(self) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
        """(timer keys, app keys) of the mode for the help screen, as (keys, description)."""
        raise NotImplementedError


class StopwatchMode(TimerMode):
    name = STOPWATCH

    def __init__(self, clock: Callable[[], float]) -> None:
        super().__init__(clock)
        self.actions = {"lap": self.lap}
        self.reset()

    def update(self) -> None:
        """Add the time elapsed since the last update."""
        now = self.clock()
        if self.running:
            self.elapsed += now - self.last
        self.last = now

    @property
    def idle(self) -> bool:
        return not self.running and self.elapsed == 0

    def tick(self) -> None:
        self.update()

    def toggle(self) -> None:
        self.update()
        self.running = not self.running

    def lap(self) -> None:
        if self.running:
            self.update()
            self.laps.append(self.elapsed)

    def skip(self) -> None:
        self.lap()

    def reset(self) -> None:
        self.running = False
        self.elapsed = 0.0
        self.laps: list[float] = []  # total elapsed time at each lap
        self.last = self.clock()

    def lap_rows(self) -> list[tuple[str, str, str, str]]:
        """(lap, lap time, style, total), newest first; fastest lap green, slowest red."""
        splits = [t - (self.laps[i - 1] if i else 0.0) for i, t in enumerate(self.laps)]
        best = splits.index(min(splits)) if len(splits) > 1 else None
        worst = splits.index(max(splits)) if len(splits) > 1 else None
        return [(str(i + 1), format_elapsed(splits[i]),
                 "green" if i == best else "red" if i == worst else "", format_elapsed(self.laps[i]))
                for i in reversed(range(len(splits)))]

    def view(self) -> View:
        state = "" if self.running else _(" (paused)")
        return View(classes=[STOPWATCH] + ([] if self.running else ["paused"]),
                    title=f"{ICONS[STOPWATCH]}  {_('Stopwatch')}{state}",
                    clock=format_elapsed(self.elapsed),
                    info=_("Laps: {n}", n=len(self.laps)),
                    laps=self.lap_rows() or None)

    def waybar_state(self, wall_time: float) -> tuple[dict, tuple, int]:
        secs = int(self.elapsed)
        return ({"mode": STOPWATCH, "running": self.running, "elapsed": secs,
                 "laps": len(self.laps), "since": wall_time},
                (STOPWATCH, self.running, len(self.laps)), secs)

    def hints(self) -> list[tuple[str, str, str]]:
        return [("l", "lap", _("Lap"))]

    def help_rows(self) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
        return ([("space", _("start / pause / resume")), ("l", _("record a lap")),
                 ("r", _("reset the time and laps"))],
                [("m", _("switch to the pomodoro"))])


@dataclass
class PomodoroEvents:
    """What a PomodoroMode reports; the App runs the side effects. All default to no-ops."""
    hook: Callable[[str, dict], None] = lambda which, env: None                 # start|end, hook env
    announce: Callable[[str, str, str], None] = lambda title, body, icon: None  # desktop notification
    notice: Callable[[str, str], None] = lambda message, severity: None         # in-app message
    work_changed: Callable[[], None] = lambda: None                             # unrecorded work changed
    cycle_complete: Callable[[], None] = lambda: None                           # the long break started


class PomodoroMode(TimerMode):
    name = POMODORO
    uses_hooks = True
    uses_profiles = True

    def __init__(self, clock: Callable[[], float], wall_clock: Callable[[], float], settings: dict,
                 profile: str | None, events: PomodoroEvents | None = None) -> None:
        super().__init__(clock)
        self.wall_clock = wall_clock  # wall time, for the time entries
        self.settings = settings
        self.profile = profile
        self.events = events or PomodoroEvents()
        self.actions = {"skip": self.skip, "extend": self.extend, "shorten": self.shorten,
                        "add_cycle": self.add_cycle, "remove_cycle": self.remove_cycle}
        self.reset()

    def reset(self) -> None:
        """Back to the freshly launched state: work, counters at zero, timer stopped."""
        s = self.settings
        self.durations = {WORK: s["work"] * 60, SHORT: s["short_break"] * 60, LONG: s["long_break"] * 60}
        self.cycles = s["cycles"]
        self.phase = WORK
        self.done_pomodoros = 0
        self.cycle_done = 0       # work sessions done in the current cycle (> / < change self.cycles)
        self.remaining = float(self.durations[WORK])
        self.phase_total = self.durations[WORK]  # length of the current phase, + extends it
        self.running = False
        self.started = False      # the first "space" is a start, not a resume
        self.last = self.clock()
        self.segment: dict | None = None  # the stretch of work in progress
        self.cycle: list[dict] = []        # finished segments of the current cycle

    @property
    def idle(self) -> bool:
        return not self.running and not self.started

    # ---- side effects, reported to the App
    def hook(self, which: str, event: str) -> None:
        """which: start|end; event: start|resume (start) or end|pause|quit|switch|reset (end)."""
        self.events.hook(which, {
            "POMO_EVENT": event, "POMO_PROFILE": self.profile or "",
            "POMO_DONE": str(self.done_pomodoros), "POMO_CYCLES": str(self.cycles),
            "POMO_WORK_MIN": str(self.durations[WORK] // 60),
        })

    def open_segment(self) -> None:
        if self.phase == WORK and self.running and self.segment is None:
            self.segment = {"work": self.cycle_done + 1, "start": self.wall_clock()}
            self.events.work_changed()

    def close_segment(self) -> None:
        if self.segment:
            self.cycle.append({**self.segment, "end": self.wall_clock()})
            self.segment = None
            self.events.work_changed()

    def take_cycle(self) -> list[dict]:
        """Hand over the finished segments of the cycle, to be recorded."""
        segments, self.cycle = self.cycle, []
        self.events.work_changed()
        return segments

    def unrecorded(self) -> tuple[dict | None, list[dict]]:
        return self.segment, self.cycle

    # ---- timer
    def start_phase(self, phase: str) -> None:
        leaving_work = self.phase == WORK and self.running
        self.phase = phase
        self.remaining = float(self.durations[phase])
        self.phase_total = self.durations[phase]
        self.running = True
        self.started = True
        self.last = self.clock()
        if phase == WORK:
            self.open_segment()
            self.hook("start", "start")
            self.events.announce(f"{ICONS[WORK]} {_('Back to work!')}",
                                 _("Session {n}/{total} — {minutes} min", n=self.cycle_done + 1,
                                   total=self.cycles, minutes=self.durations[WORK] // 60),
                                 "appointment-soon")
        else:
            if leaving_work:
                self.hook("end", "end")
            self.events.announce(f"{ICONS[phase]} {phase_label(phase)}",
                                 _("{minutes} min break — {done} pomodoro(s) done",
                                   minutes=self.durations[phase] // 60, done=self.done_pomodoros),
                                 "face-smile")

    def next_phase(self) -> None:
        if self.phase != WORK:
            self.start_phase(WORK)
            return
        self.close_segment()  # n during work cuts the entry short
        self.done_pomodoros += 1
        self.cycle_done += 1
        if self.cycle_done < self.cycles:
            self.start_phase(SHORT)
            return
        self.cycle_done = 0  # the long break opens the next cycle
        self.start_phase(LONG)
        self.events.cycle_complete()

    def tick(self) -> None:
        now = self.clock()
        if self.running:
            self.remaining -= now - self.last
        self.last = now
        if self.running and self.remaining <= 0:
            self.next_phase()

    def toggle(self) -> None:
        self.running = not self.running
        self.last = self.clock()
        if self.phase == WORK:
            if self.running:
                self.open_segment()
                self.hook("start", "resume" if self.started else "start")
            else:
                self.close_segment()  # a timer pause splits the entry
                self.hook("end", "pause")
        self.started = True

    def skip(self) -> None:
        self.next_phase()

    def interrupt(self, reason: str) -> list[dict]:
        if self.phase == WORK and self.running:
            self.hook("end", reason)
        self.close_segment()
        self.running = False
        return self.take_cycle()

    # ---- mode specific actions
    def extend(self) -> None:
        self.remaining += EXTEND_MINUTES * 60
        self.phase_total += EXTEND_MINUTES * 60
        self.events.notice(_("{phase}: +{minutes} min", phase=phase_label(self.phase),
                             minutes=EXTEND_MINUTES), "information")

    def shorten(self) -> None:
        """Remove 5 min from the current phase; with 5 min or less left, end it like n."""
        if self.remaining <= EXTEND_MINUTES * 60:
            self.next_phase()
            return
        self.remaining -= EXTEND_MINUTES * 60
        self.phase_total -= EXTEND_MINUTES * 60
        self.events.notice(_("{phase}: -{minutes} min", phase=phase_label(self.phase),
                             minutes=EXTEND_MINUTES), "information")

    def add_cycle(self) -> None:
        self.cycles += 1
        self.events.notice(_("Cycle: {n} work session(s) before the long break", n=self.cycles),
                           "information")

    def remove_cycle(self) -> None:
        """Remove a work session from the cycle, never below the current (or next) one."""
        minimum = self.cycle_done + 1
        if self.cycles <= minimum:
            self.events.notice(_("Cannot remove: this cycle needs at least {n} work session(s)",
                                 n=minimum), "warning")
            return
        self.cycles -= 1
        self.events.notice(_("Cycle: {n} work session(s) before the long break", n=self.cycles),
                           "information")

    # ---- display
    def seconds_left(self) -> int:
        return max(0, int(self.remaining + 0.999))

    def view(self) -> View:
        secs = self.seconds_left()
        mm, ss = divmod(secs, 60)
        state = "" if self.running else _(" (paused)")
        return View(classes=[self.phase] + ([] if self.running else ["paused"]),
                    title=f"{ICONS[self.phase]}  {phase_label(self.phase)}{state}",
                    clock=f"{mm:02d}:{ss:02d}",
                    info=(_("Profile: {name}  ·  ", name=self.profile) if self.profile else "")
                    + _("Pomodoros: {done}  ·  cycle {n}/{total}", done=self.done_pomodoros,
                        n=self.cycle_done + 1, total=self.cycles),
                    progress=(self.phase_total - secs, self.phase_total))

    def waybar_state(self, wall_time: float) -> tuple[dict, tuple, int]:
        secs = self.seconds_left()
        return ({"mode": POMODORO, "phase": self.phase, "running": self.running,
                 "remaining": secs, "total": self.phase_total, "done": self.done_pomodoros,
                 # end timestamp: waybar can count down without waiting for the TUI
                 "ends_at": wall_time + secs if self.running else None},
                (self.phase, self.running, self.done_pomodoros, self.phase_total), secs)

    def hints(self) -> list[tuple[str, str, str]]:
        return [("n", "skip", _("Next phase"))]

    def help_rows(self) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
        return ([("space", _("start / pause / resume")), ("n", _("next phase (ends the current one)")),
                 ("+", _("add {minutes} min to the current phase", minutes=EXTEND_MINUTES)),
                 ("-", _("remove {minutes} min (ends the phase when {minutes} min or less remain)",
                         minutes=EXTEND_MINUTES)),
                 (">", _("add a work session to the cycle (the long break comes later)")),
                 ("<", _("remove a work session from the cycle (never below the current one)")),
                 ("r", _("full reset: back to work, counters at zero"))],
                [("p", _("switch profile")), ("m", _("switch to the stopwatch"))])


# ---------------------------------------------------------------- TUI
class Pomo(App):
    CSS = """
    Screen { align: center middle; }
    #phase { text-style: bold; margin-bottom: 1; width: auto; }
    Digits { width: auto; }
    ProgressBar { margin-top: 1; }
    #info { color: $text-muted; margin-top: 1; width: auto; }
    .work #phase { color: $error; }
    .short #phase, .long #phase { color: $success; }
    .stopwatch #phase { color: $accent; }
    .paused Digits { color: $text-disabled; }
    #laps { width: auto; height: auto; max-height: 12; margin-top: 1; }
    #hints { dock: bottom; width: 100%; height: auto; padding: 0 1;
             background: $panel; color: $text-muted; text-align: center;
             link-style: none; link-color: $text-muted; link-background: transparent;
             link-style-hover: none; link-color-hover: $text; link-background-hover: $boost; }
    """

    def __init__(self, settings: dict, profile: str | None, no_hooks: bool, mode: str = POMODORO) -> None:
        super().__init__()
        self.hooks_enabled = not no_hooks  # toggled with c, kept across resets and switches
        self.settings = settings
        self.profile = profile
        self.pending: list[list[dict]] = []  # cycles waiting to be named in the form
        self.last_snapshot = 0.0
        self.timer = self.make_mode(mode)    # the current mode: the App only delegates to it

    def make_mode(self, name: str) -> TimerMode:
        """A fresh mode, with the current settings and profile."""
        if name == STOPWATCH:
            return StopwatchMode(monotonic)
        events = PomodoroEvents(
            hook=self.run_work_hook,
            announce=lambda title, body, icon: notify(title, body, icon, "critical"),
            notice=lambda message, severity: self.notify(message, severity=severity),
            work_changed=self.save_snapshot,
            cycle_complete=lambda: self.record_then(self.timer.take_cycle(), "complete"))
        return PomodoroMode(monotonic, lambda: time.time(), self.settings, self.profile, events)

    def compose(self) -> ComposeResult:
        with Middle():
            with Center():
                yield Label(id="phase")
            with Center():
                yield Digits(id="clock")
            with Center():
                yield ProgressBar(show_eta=False, show_percentage=False, id="bar")
            with Center():
                yield Label(id="info")
            with Center():
                yield DataTable(id="laps", show_cursor=False, zebra_stripes=True)
        yield Static(id="hints")

    def on_mount(self) -> None:
        self.title = "pomo"
        self.main_screen = self.screen  # the profile menu is pushed on top of it
        # mode specific keys go through mode_action(); add / subtract are the keypad + / -
        for key, action in (("space", "toggle"), ("r", "reset"), ("p", "profiles"), ("m", "mode"),
                            ("c", "hooks"), ("h,question_mark,f1", "help"), ("q", "quit"),
                            ("n", "mode_action('skip')"), ("l", "mode_action('lap')"),
                            ("plus,add", "mode_action('extend')"), ("minus,subtract", "mode_action('shorten')"),
                            ("greater_than_sign", "mode_action('add_cycle')"),
                            ("less_than_sign", "mode_action('remove_cycle')")):
            self.bind(key, action, show=False)  # labels are rendered by render_hints()
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGUSR1, self.action_toggle)  # waybar click
        loop.add_signal_handler(signal.SIGUSR2, self.skip)           # waybar right click
        laps = self.query_one("#laps", DataTable)
        laps.add_column(_("Lap"), key="n")
        laps.add_column(_("Lap time"), key="lap")
        laps.add_column(_("Total"), key="total")
        self.set_interval(0.1, self.tick)
        self.render_state()  # wait for "space" to start
        for segments, profile, ics_dir in recover_snapshots():
            self.ask_entries(segments, "recovered", profile=profile, ics_dir=ics_dir)

    def check_action(self, action: str, parameters: tuple) -> bool | None:
        """Enable only the keys of the current mode."""
        if action == "mode_action":
            return parameters[0] in self.timer.actions
        if action == "hooks":
            return self.timer.uses_hooks
        if action == "profiles":
            return self.timer.uses_profiles
        return True

    def tick(self) -> None:
        if not self.is_running:
            return  # shutting down: the widgets are being removed, do not render them
        self.timer.tick()
        segment, _cycle = self.timer.unrecorded()
        if segment and monotonic() - self.last_snapshot >= SNAPSHOT_EVERY:
            self.save_snapshot()
        self.render_state()

    # ---- time entries --------------------------------------------------
    def save_snapshot(self) -> None:
        """Persist the unrecorded work so that a crash or a closed window loses nothing."""
        self.last_snapshot = monotonic()
        segment, cycle = self.timer.unrecorded()
        if not (segment or cycle or self.pending):
            snapshot_file().unlink(missing_ok=True)
            return
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        snapshot_file().write_text(json.dumps({"profile": self.profile or "", "ics_dir": self.settings["ics_dir"],
                                               "segment": segment, "cycle": cycle, "pending": self.pending,
                                               "last_seen": time.time()}))

    def record_then(self, segments: list[dict], kind: str, then=None) -> None:
        """Ask for a title/description for the work segments worth recording, then call `then`.
        kind: "complete", "unfinished" (r, q, switch) or "recovered"."""
        segments = keep_entries(segments)
        if not segments:
            self.save_snapshot()
            if kind == "complete":
                self.notify(_("No work to record (entries under {minutes} min are ignored)",
                              minutes=MIN_ENTRY_SECONDS // 60))
            if then:
                then()
            return
        self.ask_entries(segments, kind, then)

    def ask_entries(self, segments: list[dict], kind: str, then=None,
                    profile: str | None = None, ics_dir: str | None = None) -> None:
        self.pending.append(segments)
        self.save_snapshot()
        # captured now: r / p / m change the settings once the form is closed
        profile = self.profile or "" if profile is None else profile
        ics_dir = ics_dir or self.settings["ics_dir"]

        def done(result: dict | None) -> None:
            if result is None:
                self.notify(_("Work discarded"))
            else:
                entries = record_entries(segments, result["title"], result["description"], profile)
                try:
                    path = write_cycle_ics(entries, ics_dir, result["title"])
                    self.notify(_("{n} time entry(ies) recorded in {file}", n=len(entries), file=path))
                except OSError as e:
                    self.notify(_("Time entries kept in the log, but {file} could not be written: {error}",
                                  file=ics_dir, error=e.strerror or e), severity="error", timeout=10)
            self.pending.remove(segments)
            self.save_snapshot()
            if then:
                then()

        self.push_screen(EntryForm(segments, kind, ics_dir), done)

    def leave_mode(self, reason: str, then) -> None:
        """Interrupt the mode (reason: reset|switch|quit), offer to record its work, then call `then`."""
        self.record_then(self.timer.interrupt(reason), "unfinished", then)
        self.render_state()

    # ---- actions -------------------------------------------------------
    def action_toggle(self) -> None:
        self.timer.toggle()
        self.render_state()

    def skip(self) -> None:
        """waybar right click: next phase, or a lap with the stopwatch."""
        self.timer.skip()
        self.render_state()

    def action_mode_action(self, name: str) -> None:
        self.timer.actions[name]()
        self.render_state()

    def action_reset(self) -> None:
        def reset() -> None:
            self.timer.reset()
            self.render_state()
        self.leave_mode("reset", reset)

    def action_mode(self) -> None:
        """Switch between pomodoro and stopwatch; the new mode starts fresh."""
        def switch() -> None:
            self.timer = self.make_mode(POMODORO if self.timer.name == STOPWATCH else STOPWATCH)
            self.refresh_bindings()
            self.render_state()
            self.notify(_("Stopwatch mode") if self.timer.name == STOPWATCH else _("Pomodoro mode"))
        self.leave_mode("switch", switch)

    def action_profiles(self) -> None:
        if isinstance(self.screen, ProfileMenu):
            return
        try:
            cfg = load_config()  # reread so profiles added since launch show up
            profiles = cfg.get("profiles", {})
            if not profiles:
                raise ConfigError(_("No profiles in {file}", file=CONFIG_FILE))
            entries = {name: resolve_settings(cfg, name) for name in profiles}
        except ConfigError as e:
            self.notify(str(e), severity="error")
            return

        def chosen(name: str | None) -> None:
            if name is None:
                return

            def load() -> None:
                self.settings, self.profile = entries[name], name
                self.timer = self.make_mode(self.timer.name)
                self.render_state()
                self.notify(_("Profile '{name}' loaded", name=name))
            self.leave_mode("switch", load)

        self.push_screen(ProfileMenu(entries, self.profile), chosen)

    async def action_quit(self) -> None:
        if isinstance(self.screen, EntryForm):
            return  # finish the form first
        self.leave_mode("quit", self.quit_now)

    def quit_now(self) -> None:
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()
        self.exit()

    def action_help(self) -> None:
        if not isinstance(self.screen, (HelpScreen, EntryForm)):
            self.push_screen(HelpScreen(self.help_sections()))

    def help_sections(self) -> list[tuple[str, list[tuple[str, str]]]]:
        """Keys of the current mode, as (section title, [(keys, description)])."""
        timer, app = self.timer.help_rows()
        if self.timer.uses_hooks:
            app.append(("c", _("disable the hooks (currently on)") if self.hooks_enabled
                        else _("enable the hooks (currently off)")))
        app += [("? h F1", _("this help")), ("q", _("quit"))]
        return [(_("Timer"), timer), (_("App"), app)]

    def action_hooks(self) -> None:
        """Enable / disable the work start / end hooks; takes effect from the next event."""
        self.hooks_enabled = not self.hooks_enabled
        self.render_state()
        self.notify(_("Hooks enabled") if self.hooks_enabled else _("Hooks disabled"))

    def run_work_hook(self, which: str, env: dict) -> None:
        """which: start|end; env: the POMO_* variables of the event."""
        if self.hooks_enabled:
            run_hook(self.settings["on_work_start" if which == "start" else "on_work_end"], env)

    # ---- display -------------------------------------------------------
    def hint_rows(self) -> list[list[tuple[str, str, str]]]:
        """Key hints as (key, action, label) on a single line: the essential timer keys, then
        help and quit (every other key is listed in the help). Labels say what the key will do now."""
        timer = self.timer
        toggle = _("Start") if timer.idle else _("Pause") if timer.running else _("Resume")
        return [[("space", "toggle", toggle), *timer.hints(), ("r", "reset", _("Reset")),
                 ("?", "help", _("Help")), ("q", "quit", _("Quit"))]]

    def render_hints(self) -> None:
        """Render the hint rows, wrapping whole "key label" items to the terminal width."""
        width = max(self.size.width - 2, 20)  # minus the horizontal padding
        sep = "   "
        lines = []
        for row in self.hint_rows():
            line, used = [], 0
            for key, action, label in row:
                size = cell_len(f"{key} {label}")
                if line and used + len(sep) + size > width:
                    lines.append(line)
                    line, used = [], 0
                used += (len(sep) if line else 0) + size
                click = f"mode_action('{action}')" if action in self.timer.actions else action
                # the label is the clickable part: link styling would override the key color
                line.append(f"[b $accent]{key}[/] [@click=app.{click}]{label}[/]")
            lines.append(line)
        markup = "\n".join(sep.join(line) for line in lines)
        if markup != getattr(self, "_hints", None):
            self._hints = markup
            self.main_screen.query_one("#hints", Static).update(markup)

    def on_resize(self) -> None:
        if hasattr(self, "main_screen"):
            self.render_hints()

    def render_state(self) -> None:
        self.render_hints()
        view = self.timer.view()
        if self.timer.uses_hooks and not self.hooks_enabled:
            view.info += _("  ·  hooks off")
        self.render_view(view)
        self.write_state(*self.timer.waybar_state(time.time()))

    def render_view(self, view: View) -> None:
        screen = self.main_screen
        screen.set_classes(view.classes)
        screen.query_one("#phase", Label).update(view.title)
        screen.query_one("#clock", Digits).update(view.clock)
        screen.query_one("#info", Label).update(view.info)
        bar = screen.query_one("#bar", ProgressBar)
        bar.display = view.progress is not None
        if view.progress is not None:
            done, total = view.progress
            bar.update(total=total, progress=done)
        table = screen.query_one("#laps", DataTable)
        table.display = view.laps is not None
        if (view.laps or []) != getattr(self, "_lap_rows", []):  # rebuild only when laps change
            self._lap_rows = view.laps or []
            table.clear()
            for n, lap, style, total in self._lap_rows:
                table.add_row(n, Text(lap, style=style), total)

    def write_state(self, data: dict, key: tuple, tick: int) -> None:
        """Write the waybar state file when the displayed second changes;
        signal waybar right away only when `key` (mode, phase, running...) changes."""
        old = getattr(self, "_last_state", None)
        if old != (key, tick):
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps({"pid": os.getpid(), "lang": lang, **data}))
            tmp.replace(STATE_FILE)
            if old is None or old[0] != key:
                refresh_waybar()
            self._last_state = (key, tick)

class HelpScreen(ModalScreen[None]):
    """Lists the keys of the current mode; closed with Esc, q or the help keys."""

    CSS = """
    HelpScreen { align: center middle; }
    #help { width: 84; max-width: 95%; height: auto; max-height: 100%; overflow-y: auto;
            padding: 0 2; border: round $accent; background: $surface; }
    #help-title { text-style: bold; margin: 1 0; }
    .help-section { text-style: bold; color: $text-muted; }
    .help-keys { margin-bottom: 1; }
    #help-note, #help-close { color: $text-muted; width: 100%; }
    #help-close { margin-bottom: 1; }
    """
    BINDINGS = [Binding("escape,q,question_mark,h,f1", "dismiss(None)", show=False)]

    def __init__(self, sections: list[tuple[str, list[tuple[str, str]]]]) -> None:
        super().__init__()
        self.sections = sections

    def compose(self) -> ComposeResult:
        width = max(len(keys) for _title, rows in self.sections for keys, _desc in rows) + 3
        with Vertical(id="help"):
            yield Label(_("Keys"), id="help-title")
            for title, rows in self.sections:
                yield Label(title, classes="help-section")
                text = Text()
                for i, (keys, desc) in enumerate(rows):
                    text.append(("\n" if i else "") + keys.ljust(width), style="bold")
                    text.append(desc)
                yield Static(text, classes="help-keys")
            yield Label(_("Work time is recorded at the end of each cycle (title asked in a form)."), id="help-note")
            yield Label(_("Esc, q or ?: close"), id="help-close")


class ProfileList(OptionList):
    BINDINGS = [
        Binding("j", "cursor_down", show=False),
        Binding("k", "cursor_up", show=False),
    ]


class ProfileMenu(ModalScreen[str | None]):
    """Profile picker: returns the chosen profile name, or None if cancelled."""

    CSS = """
    ProfileMenu { align: center middle; }
    #menu { width: auto; max-width: 90%; height: auto; padding: 1 2;
            border: round $accent; background: $surface; }
    #menu-title { text-style: bold; margin-bottom: 1; }
    ProfileList { width: auto; height: auto; max-height: 20; border: none; }
    #menu-help { color: $text-muted; margin-top: 1; }
    """
    BINDINGS = [Binding("escape", "dismiss(None)", show=False)]

    def __init__(self, entries: dict[str, dict], current: str | None) -> None:
        super().__init__()
        self.entries = entries
        self.current = current

    def compose(self) -> ComposeResult:
        options = [
            Option(f"{'●' if name == self.current else ' '} {name:<12} " + _(
                "work {work} min · break {short} min · long break {long} min · {cycles} cycles",
                work=v["work"], short=v["short_break"], long=v["long_break"], cycles=v["cycles"]), id=name)
            for name, v in self.entries.items()
        ]
        with Vertical(id="menu"):
            yield Label(_("Choose a profile"), id="menu-title")
            yield ProfileList(*options)
            yield Label(_("↑↓ / j k: move · Enter: select · Esc: cancel"), id="menu-help")

    def on_mount(self) -> None:
        menu = self.query_one(ProfileList)
        names = list(self.entries)
        menu.highlighted = names.index(self.current) if self.current in names else 0
        menu.focus()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        self.dismiss(event.option.id)


class EntryForm(ModalScreen[dict | None]):
    """Names the work time entries of a cycle: returns {title, description}, or None to discard."""

    CSS = """
    EntryForm { align: center middle; }
    #form { width: 80; max-width: 95%; height: auto; max-height: 100%; overflow-y: auto;
            padding: 0 2; border: round $accent; background: $surface; }
    #form-title { text-style: bold; margin-bottom: 1; }
    #preview { color: $text-muted; margin-bottom: 1; }
    #form Input { margin-bottom: 1; }
    #desc { height: 4; }
    #error { color: $error; }
    #buttons { height: auto; align-horizontal: right; margin-top: 1; }
    #buttons Button { margin-left: 2; }
    #form-help { color: $text-muted; margin-top: 1; }
    #form-title { margin-top: 1; }
    """
    BINDINGS = [Binding("ctrl+s", "save", show=False)]
    HEADINGS = {
        "complete": "Cycle complete: record your work",
        "unfinished": "Unfinished cycle: record your work",
        "recovered": "Unrecorded work from a previous session",
    }

    def __init__(self, segments: list[dict], kind: str, ics_dir: str) -> None:
        super().__init__()
        self.segments = segments
        self.kind = kind
        self.ics_dir = ics_dir

    def compose(self) -> ComposeResult:
        with Vertical(id="form"):
            yield Label(_(self.HEADINGS[self.kind]), id="form-title")
            yield Static(id="preview")
            yield Label(_("Title (required)"))
            yield Input(id="title")
            yield Label(_("Description (optional)"))
            yield TextArea(id="desc", soft_wrap=True)
            yield Label(id="error")
            with Horizontal(id="buttons"):
                yield Button(_("Discard"), id="discard", variant="error", compact=True)
                yield Button(_("Save"), id="save", variant="primary", compact=True)
            yield Label(_("Enter: next field · Ctrl+S: save"), id="form-help")

    def on_mount(self) -> None:
        self.render_preview("")
        self.query_one("#title", Input).focus()

    def render_preview(self, title: str) -> None:
        """List the entries as they will be named, updated while the title is typed."""
        lines = []
        for seg, name in zip(self.segments, entry_names(title or "…", self.segments)):
            start, end = datetime.fromtimestamp(seg["start"]), datetime.fromtimestamp(seg["end"])
            minutes = round((seg["end"] - seg["start"]) / 60)
            lines.append(f"• {name}   {start:%H:%M}–{end:%H:%M}  ({minutes} min)")
        start = self.segments[0]["start"]
        target = (ics_path(self.ics_dir, title, start) if title else
                  Path(self.ics_dir).expanduser() / f"{datetime.fromtimestamp(start):%Y-%m-%d_%H%M}_….ics")
        home = str(Path.home())
        lines.append(_("Calendar file: {file}", file=str(target).replace(home, "~", 1)))
        self.query_one("#preview", Static).update(Text("\n".join(lines)))

    def on_input_changed(self, event: Input.Changed) -> None:
        self.render_preview(event.value.strip())
        self.query_one("#error", Label).update("")

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.query_one("#desc", TextArea).focus()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "save":
            self.action_save()
        else:
            self.dismiss(None)

    def action_save(self) -> None:
        title = self.query_one("#title", Input).value.strip()
        if not title:
            self.query_one("#error", Label).update(_("The title is required"))
            self.query_one("#title", Input).focus()
            return
        self.dismiss({"title": title, "description": self.query_one("#desc", TextArea).text.strip()})


# ---------------------------------------------------------------- config
DEFAULTS = {
    "work": 25, "short_break": 5, "long_break": 15, "cycles": 4,
    "on_work_start": "pomo-media resume",
    "on_work_end": "pomo-media pause",
    "ics_dir": "~/.local/share/pomo/ics",
}
INT_KEYS = ("work", "short_break", "long_break", "cycles")
HOOK_KEYS = ("on_work_start", "on_work_end")
PATH_KEYS = ("ics_dir",)
LEGACY_KEYS = ("profils", "defaut", "commandes")


def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    try:
        with CONFIG_FILE.open("rb") as f:
            cfg = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(_("error in {file}: {error}", file=CONFIG_FILE, error=e))
    if any(k in cfg for k in LEGACY_KEYS):
        raise ConfigError(_("{file} uses the old French keys (profils, defaut, commandes...): "
               "update it, see config.toml in the project", file=CONFIG_FILE))
    return cfg


def parse_values(table: dict, where: str, allowed: tuple[str, ...]) -> dict:
    for key, val in table.items():
        if key not in allowed:
            raise ConfigError(_("unknown key '{key}' in {where} (expected: {keys})",
                   key=key, where=where, keys=", ".join(allowed)))
        if key in INT_KEYS and (not isinstance(val, int) or isinstance(val, bool) or val <= 0):
            raise ConfigError(_("'{key}' must be an integer > 0 ({where})", key=key, where=where))
        if key in HOOK_KEYS + PATH_KEYS and not isinstance(val, str):
            raise ConfigError(_("'{key}' must be a string ({where})", key=key, where=where))
    return dict(table)


def profile_values(profiles: dict, name: str) -> dict:
    if name not in profiles:
        raise ConfigError(_("profile '{name}' not found (available: {names})",
               name=name, names=", ".join(profiles) or _("none")))
    return parse_values(profiles[name], _("profile '{name}'", name=name), INT_KEYS + HOOK_KEYS + PATH_KEYS)


def resolve_settings(cfg: dict, profile: str | None) -> dict:
    """defaults < [hooks] < profile."""
    settings = {**DEFAULTS, **parse_values(cfg.get("hooks", {}), "[hooks]", HOOK_KEYS)}
    if profile:
        settings.update(profile_values(cfg.get("profiles", {}), profile))
    return settings


def positive_int(v: str) -> int:
    n = int(v)
    if n <= 0:
        raise argparse.ArgumentTypeError(_("must be an integer > 0"))
    return n


def iso_date(value: str) -> date:
    try:
        return date.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError(_("invalid date: {value} (expected YYYY-MM-DD)", value=value))


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description=_("Pomodoro TUI: runs commands when work starts/ends (pauses/resumes media by default)"),
        epilog=_("Config: {file}. Precedence: defaults < [hooks] < profile < CLI options. "
                 "Hooks receive POMO_EVENT (start|resume|end|pause|quit|switch|reset), POMO_PROFILE, "
                 "POMO_DONE, POMO_CYCLES, POMO_WORK_MIN.", file=CONFIG_FILE),
    )
    ap.add_argument("-p", "--profile", help=_("profile to use (default: default_profile from the config file)"))
    ap.add_argument("-L", "--list", action="store_true", help=_("list profiles and exit"))
    ap.add_argument("-w", "--work", type=positive_int, help=_("work minutes ({default})", default=DEFAULTS["work"]))
    ap.add_argument("-s", "--short-break", type=positive_int,
                    help=_("short break minutes ({default})", default=DEFAULTS["short_break"]))
    ap.add_argument("-l", "--long-break", type=positive_int,
                    help=_("long break minutes ({default})", default=DEFAULTS["long_break"]))
    ap.add_argument("-c", "--cycles", type=positive_int,
                    help=_("work sessions before the long break ({default})", default=DEFAULTS["cycles"]))
    ap.add_argument("--on-work-start", metavar="CMD",
                    help=_("command run when work starts (\"{default}\")", default=DEFAULTS["on_work_start"]))
    ap.add_argument("--ics-dir", metavar="DIR",
                    help=_("directory for the .ics file written at the end of each cycle ({default})",
                           default=DEFAULTS["ics_dir"]))
    ap.add_argument("--on-work-end", metavar="CMD",
                    help=_("command run when work ends (\"{default}\")", default=DEFAULTS["on_work_end"]))
    ap.add_argument("--no-hooks", action="store_true",
                    help=_("start with the hooks disabled (h toggles them in the app)"))
    ap.add_argument("--stopwatch", action="store_true", help=_("start in stopwatch mode"))
    ap.add_argument("--export-ics", nargs="?", const="pomo-sessions.ics", metavar="FILE",
                    help=_("export the recorded time entries as an iCalendar (.ics) file (default: {file}, - for stdout)",
                           file="pomo-sessions.ics"))
    ap.add_argument("--since", type=iso_date, metavar="DATE",
                    help=_("with --export-ics: only entries on or after DATE (YYYY-MM-DD)"))
    ap.add_argument("--until", type=iso_date, metavar="DATE",
                    help=_("with --export-ics: only entries on or before DATE (YYYY-MM-DD)"))
    ap.add_argument("--lang", choices=("auto", *LANGUAGES),
                    help=_("UI language: {langs} (default: auto)", langs=", ".join(LANGUAGES)))
    return ap


def main() -> None:
    global lang
    # The language must be known before building translated help texts.
    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--lang")
    cli_lang = pre.parse_known_args()[0].lang
    lang = resolve_language(cli_lang, os.environ.get("POMO_LANG"))
    try:
        cfg = load_config()
    except ConfigError as e:
        fail(str(e))
    lang = resolve_language(cli_lang, os.environ.get("POMO_LANG"), cfg.get("language"))

    args = build_parser().parse_args()
    try:
        run(args, cfg)
    except ConfigError as e:
        fail(str(e))


def run(args: argparse.Namespace, cfg: dict) -> None:
    profiles, default_profile = cfg.get("profiles", {}), cfg.get("default_profile")

    if args.export_ics:
        export_ics(args.export_ics, args.since, args.until)
        return

    if args.list:
        if not profiles:
            print(_("No profiles ({file})", file=CONFIG_FILE))
        for name in profiles:
            v = resolve_settings(cfg, name)
            mark = "*" if name == default_profile else " "
            print(f"{mark} {name:<12} " + _(
                "work {work} min · break {short} min · long break {long} min · {cycles} cycles",
                work=v["work"], short=v["short_break"], long=v["long_break"], cycles=v["cycles"]))
            print(f"  {'':<12} " + _("start: {start}  ·  end: {end}",
                                     start=v["on_work_start"] or _("(nothing)"),
                                     end=v["on_work_end"] or _("(nothing)")))
            print(f"  {'':<12} " + _("ics files: {dir}", dir=v["ics_dir"]))
        return

    name = args.profile or default_profile
    settings = resolve_settings(cfg, name)
    for key in DEFAULTS:  # explicit CLI options win
        if getattr(args, key) is not None:
            settings[key] = getattr(args, key)

    app = Pomo(settings, name, args.no_hooks, STOPWATCH if args.stopwatch else POMODORO)
    try:
        app.run()
    finally:
        app.close_segment()  # unrecorded work stays in the snapshot for the next launch
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()


if __name__ == "__main__":
    main()
