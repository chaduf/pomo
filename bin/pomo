#!/usr/bin/python3
"""Launcher of pomo: finds the pomo package and runs it.

The package is looked up next to this script's directory (the repository, or a symlinked
install) and then in ~/.local/lib/pomo (a copied install)."""
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
for root in (here.parent, Path.home() / ".local" / "lib" / "pomo"):
    if (root / "pomo" / "__init__.py").is_file():
        sys.path.insert(0, str(root))
        break

from pomo.main import main  # noqa: E402  (needs the path set above)

main(str(here))
