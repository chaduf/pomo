#!/usr/bin/python3
"""pomo — minuteur Pomodoro TUI qui lance des commandes au début et à la fin
des périodes de travail (par défaut : play/pause de mpv via playerctl),
envoie des notifications et expose son état à waybar.

Profils : ~/.config/pomo/config.toml  (pomo -L pour les lister, pomo -p NOM)
Commandes : debut_travail / fin_travail (config) ou --debut-travail / --fin-travail (CLI)
Touches : espace = pause/reprise, n = phase suivante, r = reset phase, q = quitter
Signaux : SIGUSR1 = pause/reprise, SIGUSR2 = phase suivante (utilisés par waybar)
"""
import argparse
import asyncio
import json
import os
import signal
import subprocess
import time
import tomllib
from pathlib import Path

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Center, Middle
from textual.widgets import Digits, Footer, Label, ProgressBar

STATE_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "pomo.json"
WAYBAR_SIGNAL = 9  # doit correspondre à "signal" dans le module waybar

WORK, SHORT, LONG = "work", "short", "long"
LABELS = {WORK: "Travail", SHORT: "Pause courte", LONG: "Pause longue"}
ICONS = {WORK: "🍅", SHORT: "☕", LONG: "🌴"}


def sh(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def run_hook(cmd: str, env: dict[str, str]) -> None:
    """Lance une commande shell utilisateur sans bloquer le TUI."""
    if not cmd.strip():
        return
    try:
        subprocess.Popen(
            ["sh", "-c", cmd], env={**os.environ, **env}, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def notify(title: str, body: str, icon: str, urgency: str = "normal") -> None:
    subprocess.Popen(
        ["notify-send", "-a", "pomo", "-u", urgency, "-i", icon,
         "-h", "string:x-canonical-private-synchronous:pomo", title, body],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def refresh_waybar() -> None:
    sh("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


class Pomo(App):
    CSS = """
    Screen { align: center middle; }
    #phase { text-style: bold; margin-bottom: 1; width: auto; }
    Digits { width: auto; }
    ProgressBar { margin-top: 1; }
    #info { color: $text-muted; margin-top: 1; width: auto; }
    .work #phase { color: $error; }
    .short #phase, .long #phase { color: $success; }
    .paused Digits { color: $text-disabled; }
    """
    BINDINGS = [
        Binding("space", "toggle", "Pause/Reprise"),
        Binding("n", "skip", "Phase suivante"),
        Binding("r", "reset", "Reset phase"),
        Binding("q", "quit", "Quitter"),
    ]

    def __init__(self, args: argparse.Namespace) -> None:
        super().__init__()
        self.durations = {WORK: args.work * 60, SHORT: args.short * 60, LONG: args.long * 60}
        self.cycles = args.cycles
        self.hooks = {} if args.no_hooks else {"start": args.work_start, "end": args.work_end}
        self.profile = args.profile
        self.phase = WORK
        self.done_pomodoros = 0
        self.remaining = float(self.durations[WORK])
        self.running = False
        self.started = False  # le premier « espace » est un début, pas une reprise
        self.last_tick = time.monotonic()

    def compose(self) -> ComposeResult:
        with Middle():
            with Center():
                yield Label(id="phase")
            with Center():
                yield Digits(id="clock")
            with Center():
                yield ProgressBar(show_eta=False, show_percentage=False, id="bar")
            with Center():
                yield Label(id="info")
        yield Footer()

    def on_mount(self) -> None:
        self.title = "pomo"
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGUSR1, self.action_toggle)
        loop.add_signal_handler(signal.SIGUSR2, self.action_skip)
        self.set_interval(0.25, self.tick)
        self.render_state()  # on attend « espace » pour démarrer

    # ---- logique -------------------------------------------------------
    def start_phase(self, phase: str, announce: bool = True) -> None:
        leaving_work = self.phase == WORK and self.running
        self.phase = phase
        self.remaining = float(self.durations[phase])
        self.running = True
        self.started = True
        self.last_tick = time.monotonic()
        if phase == WORK:
            self.hook("start", "start")
        elif leaving_work:
            self.hook("end", "end")
        if announce:
            if phase == WORK:
                notify("🍅 Au travail !", f"Session {self.done_pomodoros % self.cycles + 1}/{self.cycles} "
                       f"— {self.durations[WORK] // 60} min", "appointment-soon", "critical")
            else:
                notify(f"{ICONS[phase]} {LABELS[phase]}", f"{self.durations[phase] // 60} min de pause "
                       f"— {self.done_pomodoros} pomodoro(s) fait(s)", "face-smile", "critical")
        self.render_state()

    def next_phase(self) -> None:
        if self.phase == WORK:
            self.done_pomodoros += 1
            nxt = LONG if self.done_pomodoros % self.cycles == 0 else SHORT
        else:
            nxt = WORK
        self.start_phase(nxt)

    def tick(self) -> None:
        now = time.monotonic()
        if self.running:
            self.remaining -= now - self.last_tick
            if self.remaining <= 0:
                self.next_phase()
                return
        self.last_tick = now
        self.render_state()

    # ---- actions -------------------------------------------------------
    def action_toggle(self) -> None:
        self.running = not self.running
        self.last_tick = time.monotonic()
        if self.phase == WORK:
            if self.running:
                self.hook("start", "resume" if self.started else "start")
            else:
                self.hook("end", "pause")
        self.started = True
        self.render_state()

    def action_skip(self) -> None:
        self.next_phase()

    def action_reset(self) -> None:
        self.remaining = float(self.durations[self.phase])
        self.render_state()

    async def action_quit(self) -> None:
        if self.phase == WORK and self.running:
            self.hook("end", "quit")
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()
        self.exit()

    def hook(self, which: str, event: str) -> None:
        """which : start|end ; event : start|resume (début) ou end|pause|quit (fin)."""
        run_hook(self.hooks.get(which, ""), {
            "POMO_EVENT": event, "POMO_PROFILE": self.profile or "",
            "POMO_DONE": str(self.done_pomodoros), "POMO_CYCLES": str(self.cycles),
            "POMO_WORK_MIN": str(self.durations[WORK] // 60),
        })

    # ---- affichage -----------------------------------------------------
    def render_state(self) -> None:
        secs = max(0, int(self.remaining + 0.999))
        mm, ss = divmod(secs, 60)
        total = self.durations[self.phase]
        self.screen.set_classes([self.phase] + ([] if self.running else ["paused"]))
        state = "" if self.running else "  (en pause)"
        self.query_one("#phase", Label).update(f"{ICONS[self.phase]}  {LABELS[self.phase]}{state}")
        self.query_one("#clock", Digits).update(f"{mm:02d}:{ss:02d}")
        self.query_one("#bar", ProgressBar).update(total=total, progress=total - secs)
        self.query_one("#info", Label).update(
            (f"Profil : {self.profile}  ·  " if self.profile else "")
            + f"Pomodoros : {self.done_pomodoros}  ·  cycle {self.done_pomodoros % self.cycles + 1}/{self.cycles}"
        )
        self.write_state(secs, total)

    def write_state(self, secs: int, total: int) -> None:
        data = {
            "pid": os.getpid(), "phase": self.phase, "running": self.running,
            "remaining": secs, "total": total, "done": self.done_pomodoros,
            # horodatage de fin : waybar peut décompter sans attendre le TUI
            "ends_at": time.time() + secs if self.running else None,
        }
        old = getattr(self, "_last_state", None)
        if old != (self.phase, self.running, self.done_pomodoros, secs):
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(data))
            tmp.replace(STATE_FILE)
            if old is None or old[:3] != (self.phase, self.running, self.done_pomodoros):
                refresh_waybar()
            self._last_state = (self.phase, self.running, self.done_pomodoros, secs)


CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pomo" / "config.toml"
DEFAULTS = {
    "work": 25, "short": 5, "long": 15, "cycles": 4,
    "work_start": "playerctl -a -p mpv play",
    "work_end": "playerctl -a -p mpv pause",
}
# clés du fichier de config -> paramètres internes
INT_KEYS = {"travail": "work", "pause": "short", "pause_longue": "long", "repetitions": "cycles"}
STR_KEYS = {"debut_travail": "work_start", "fin_travail": "work_end"}
CONFIG_KEYS = INT_KEYS | STR_KEYS


def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    try:
        with CONFIG_FILE.open("rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise SystemExit(f"pomo : erreur dans {CONFIG_FILE} : {e}")


def parse_values(table: dict, where: str, allowed: dict) -> dict:
    values = {}
    for key, val in table.items():
        if key not in allowed:
            raise SystemExit(f"pomo : clé inconnue « {key} » dans {where} "
                             f"(attendu : {', '.join(allowed)})")
        if key in INT_KEYS and (not isinstance(val, int) or isinstance(val, bool) or val <= 0):
            raise SystemExit(f"pomo : « {key} » doit être un entier > 0 ({where})")
        if key in STR_KEYS and not isinstance(val, str):
            raise SystemExit(f"pomo : « {key} » doit être une chaîne ({where})")
        values[allowed[key]] = val
    return values


def global_values(cfg: dict) -> dict:
    """Commandes définies dans [commandes] : s'appliquent à tous les profils."""
    return parse_values(cfg.get("commandes", {}), "[commandes]", STR_KEYS)


def profile_values(profiles: dict, name: str) -> dict:
    if name not in profiles:
        dispo = ", ".join(profiles) or "aucun"
        raise SystemExit(f"pomo : profil « {name} » introuvable (disponibles : {dispo})")
    return parse_values(profiles[name], f"le profil « {name} »", CONFIG_KEYS)


def positive_int(v: str) -> int:
    n = int(v)
    if n <= 0:
        raise argparse.ArgumentTypeError("doit être un entier > 0")
    return n


def main() -> None:
    cfg = load_config()
    profiles, default_profile = cfg.get("profils", {}), cfg.get("defaut")
    base = {**DEFAULTS, **global_values(cfg)}
    ap = argparse.ArgumentParser(
        description="Pomodoro TUI : lance des commandes au début/à la fin du travail (mpv par défaut)",
        epilog=f"Config : {CONFIG_FILE}. Priorité : défauts < [commandes] < profil < options CLI. "
               "Les commandes reçoivent POMO_EVENT (start|resume|end|pause|quit), POMO_PROFILE, "
               "POMO_DONE, POMO_CYCLES, POMO_WORK_MIN.",
    )
    ap.add_argument("-p", "--profile", help="profil à utiliser (défaut : « defaut » du fichier de config)")
    ap.add_argument("-L", "--list", action="store_true", help="lister les profils et quitter")
    ap.add_argument("-w", "--work", type=positive_int, help=f"minutes de travail ({DEFAULTS['work']})")
    ap.add_argument("-s", "--short", type=positive_int, help=f"minutes de pause ({DEFAULTS['short']})")
    ap.add_argument("-c", "--cycles", type=positive_int,
                    help=f"répétitions (pomodoros) avant la pause longue ({DEFAULTS['cycles']})")
    ap.add_argument("-l", "--long", type=positive_int, help=f"minutes de pause longue ({DEFAULTS['long']})")
    ap.add_argument("--debut-travail", dest="work_start", metavar="CMD",
                    help=f"commande au début du travail (« {DEFAULTS['work_start']} »)")
    ap.add_argument("--fin-travail", dest="work_end", metavar="CMD",
                    help=f"commande à la fin du travail (« {DEFAULTS['work_end']} »)")
    ap.add_argument("--no-hooks", "--no-mpv", dest="no_hooks", action="store_true",
                    help="ne lancer aucune commande")
    args = ap.parse_args()

    if args.list:
        if not profiles:
            print(f"Aucun profil ({CONFIG_FILE})")
        for name in profiles:
            v = {**base, **profile_values(profiles, name)}
            mark = "*" if name == default_profile else " "
            print(f"{mark} {name:<12} travail {v['work']} min · pause {v['short']} min · "
                  f"pause longue {v['long']} min · {v['cycles']} répétitions")
            print(f"  {'':<12} début : {v['work_start'] or '(rien)'}  ·  fin : {v['work_end'] or '(rien)'}")
        return

    name = args.profile or default_profile
    settings = dict(base)
    if name:
        settings.update(profile_values(profiles, name))
    for key in DEFAULTS:  # les options CLI explicites priment
        if getattr(args, key) is not None:
            settings[key] = getattr(args, key)
    args = argparse.Namespace(**settings, no_hooks=args.no_hooks, profile=name)

    try:
        Pomo(args).run()
    finally:
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()


if __name__ == "__main__":
    main()
