        "Profile '{name}' loaded": "Profil « {name} » chargé",
    },
}
LANGUAGES = ("en", *TRANSLATIONS)
lang = "en"


def _(text: str, **kwargs) -> str:
    text = TRANSLATIONS.get(lang, {}).get(text, text)
    return text.format(**kwargs) if kwargs else text


def resolve_language(*candidates: str | None) -> str:
    """First explicit candidate wins; 'auto' or None falls through to the locale."""
    for c in candidates:
        if c and c != "auto":
            return c if c in LANGUAGES else "en"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        code = os.environ.get(var, "")[:2]
        if code:
            return code if code in LANGUAGES else "en"
    return "en"


class ConfigError(Exception):
    """Invalid config: fatal at startup, shown as an in-app error when switching profiles."""


def fail(message: str) -> None:
    raise SystemExit(f"pomo: {message}")


# ---------------------------------------------------------------- helpers
def sh(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


# Directory holding pomo (and pomo-media). Prepended to the hooks' PATH because launchers
# (rofi, app menus) often run pomo without ~/.local/bin in PATH.
BIN_DIR = str(Path(__file__).resolve().parent)


def run_hook(cmd: str, env: dict[str, str]) -> None:
    """Run a user shell command without blocking the TUI."""
    if not cmd.strip():
        return
    path = os.pathsep.join([BIN_DIR, os.environ.get("PATH", "")])
    try:
        subprocess.Popen(
            ["sh", "-c", cmd], env={**os.environ, **env, "PATH": path}, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def notify(title: str, body: str, icon: str, urgency: str = "normal") -> None:
    subprocess.Popen(
        ["notify-send", "-a", "pomo", "-u", urgency, "-i", icon,
         "-h", "string:x-canonical-private-synchronous:pomo", title, body],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def refresh_waybar() -> None:
    sh("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


def format_elapsed(seconds: float) -> str:
    """MM:SS.d below one hour, H:MM:SS.d above."""
    tenths = int(seconds * 10)
    h, rest = divmod(tenths, 36000)
    m, rest = divmod(rest, 600)
    sec, d = divmod(rest, 10)
    return f"{h}:{m:02d}:{sec:02d}.{d}" if h else f"{m:02d}:{sec:02d}.{d}"


def phase_label(phase: str) -> str:
    return _({WORK: "Work", SHORT: "Short break", LONG: "Long break"}[phase])


# ---------------------------------------------------------------- TUI
class Pomo(App):
    CSS = """
    Screen { align: center middle; }
    #phase { text-style: bold; margin-bottom: 1; width: auto; }
    Digits { width: auto; }
    ProgressBar { margin-top: 1; }
    #info { color: $text-muted; margin-top: 1; width: auto; }
    .work #phase { color: $error; }
    .short #phase, .long #phase { color: $success; }
    .stopwatch #phase { color: $accent; }
    .paused Digits { color: $text-disabled; }
    #laps { width: auto; height: auto; max-height: 12; margin-top: 1; }
    #hints { dock: bottom; width: 100%; height: auto; padding: 0 1;
             background: $panel; color: $text-muted; text-align: center;
             link-style: none; link-color: $text-muted; link-background: transparent;
             link-style-hover: none; link-color-hover: $text; link-background-hover: $boost; }
    """

    def __init__(self, settings: dict, profile: str | None, no_hooks: bool, mode: str = POMODORO) -> None:
        super().__init__()
        self.no_hooks = no_hooks
        self.mode = mode
        self.load_profile(settings, profile)
        self.reset_stopwatch()

    def load_profile(self, settings: dict, profile: str | None) -> None:
        """Apply settings and reset the timer to its freshly launched state."""
        self.settings = settings
        self.durations = {WORK: settings["work"] * 60, SHORT: settings["short_break"] * 60,
                          LONG: settings["long_break"] * 60}
        self.cycles = settings["cycles"]
        self.hooks = {} if self.no_hooks else {"start": settings["on_work_start"], "end": settings["on_work_end"]}
        self.profile = profile
        self.phase = WORK
        self.done_pomodoros = 0
        self.remaining = float(self.durations[WORK])
        self.running = False
        self.started = False  # the first "space" is a start, not a resume
        self.last_tick = time.monotonic()

    def reset_stopwatch(self) -> None:
        self.elapsed = 0.0
        self.laps: list[float] = []  # total elapsed time at each lap
        if self.mode == STOPWATCH:
            self.running = False
        self.last_tick = time.monotonic()

    def compose(self) -> ComposeResult:
        with Middle():
            with Center():
                yield Label(id="phase")
            with Center():
                yield Digits(id="clock")
            with Center():
                yield ProgressBar(show_eta=False, show_percentage=False, id="bar")
            with Center():
                yield Label(id="info")
            with Center():
                yield DataTable(id="laps", show_cursor=False, zebra_stripes=True)
        yield Static(id="hints")

    def on_mount(self) -> None:
        self.title = "pomo"
        self.main_screen = self.screen  # the profile menu is pushed on top of it
        for key, action in (("space", "toggle"), ("n", "skip"), ("l", "lap"), ("r", "reset"),
                            ("p", "profiles"), ("m", "mode"), ("q", "quit")):
            self.bind(key, action, show=False)  # labels are rendered by render_hints()
        loop = asyncio.get_running_loop()
        loop.add_signal_handler(signal.SIGUSR1, self.action_toggle)
        loop.add_signal_handler(signal.SIGUSR2, self.action_skip)
        laps = self.query_one("#laps", DataTable)
        laps.add_column(_("Lap"), key="n")
        laps.add_column(_("Lap time"), key="lap")
        laps.add_column(_("Total"), key="total")
        self.set_interval(0.1, self.tick)
        self.render_state()  # wait for "space" to start

    def check_action(self, action: str, parameters: tuple) -> bool | None:
        """Hide the bindings that do not apply to the current mode."""
        if action in ("skip", "profiles"):
            return self.mode == POMODORO
        if action == "lap":
            return self.mode == STOPWATCH
        return True

    # ---- logic ---------------------------------------------------------
    def start_phase(self, phase: str, announce: bool = True) -> None:
        leaving_work = self.phase == WORK and self.running
        self.phase = phase
        self.remaining = float(self.durations[phase])
        self.running = True
        self.started = True
        self.last_tick = time.monotonic()
        if phase == WORK:
            self.hook("start", "start")
        elif leaving_work:
            self.hook("end", "end")
        if announce:
            if phase == WORK:
                notify(f"{ICONS[WORK]} {_('Back to work!')}",
                       _("Session {n}/{total} — {minutes} min", n=self.done_pomodoros % self.cycles + 1,
                         total=self.cycles, minutes=self.durations[WORK] // 60),
                       "appointment-soon", "critical")
            else:
                notify(f"{ICONS[phase]} {phase_label(phase)}",
                       _("{minutes} min break — {done} pomodoro(s) done",
                         minutes=self.durations[phase] // 60, done=self.done_pomodoros),
                       "face-smile", "critical")
        self.render_state()

    def next_phase(self) -> None:
        if self.phase == WORK:
            self.done_pomodoros += 1
            nxt = LONG if self.done_pomodoros % self.cycles == 0 else SHORT
        else:
            nxt = WORK
        self.start_phase(nxt)

    def tick(self) -> None:
        now = time.monotonic()
        if self.running and self.mode == STOPWATCH:
            self.elapsed += now - self.last_tick
        elif self.running:
            self.remaining -= now - self.last_tick
            if self.remaining <= 0:
                self.next_phase()
                return
        self.last_tick = now
        self.render_state()

    # ---- actions -------------------------------------------------------
    def action_toggle(self) -> None:
        self.running = not self.running
        self.last_tick = time.monotonic()
        if self.mode == POMODORO and self.phase == WORK:
            if self.running:
                self.hook("start", "resume" if self.started else "start")
            else:
                self.hook("end", "pause")
        self.started = True
        self.render_state()

    def action_skip(self) -> None:
        if self.mode == STOPWATCH:
            self.action_lap()  # waybar right click
        else:
            self.next_phase()

    def action_lap(self) -> None:
        if self.mode == STOPWATCH and self.running:
            self.laps.append(self.elapsed)
            self.render_laps()
            self.render_state()

    def action_reset(self) -> None:
        if self.mode == STOPWATCH:
            self.reset_stopwatch()
            self.render_laps()
        else:
            self.remaining = float(self.durations[self.phase])
        self.render_state()

    def action_mode(self) -> None:
        """Switch between pomodoro and stopwatch; the new mode starts fresh."""
        if self.mode == POMODORO and self.phase == WORK and self.running:
            self.hook("end", "switch")
        self.mode = STOPWATCH if self.mode == POMODORO else POMODORO
        self.load_profile(self.settings, self.profile)
        self.reset_stopwatch()
        self.render_laps()
        self.refresh_bindings()
        self.render_state()
        self.notify(_("Stopwatch mode") if self.mode == STOPWATCH else _("Pomodoro mode"))

    def action_profiles(self) -> None:
        if isinstance(self.screen, ProfileMenu):
            return
        try:
            cfg = load_config()  # reread so profiles added since launch show up
            profiles = cfg.get("profiles", {})
            if not profiles:
                raise ConfigError(_("No profiles in {file}", file=CONFIG_FILE))
            entries = {name: resolve_settings(cfg, name) for name in profiles}
        except ConfigError as e:
            self.notify(str(e), severity="error")
            return

        def switch(name: str | None) -> None:
            if name is None:
                return
            if self.phase == WORK and self.running:
                self.hook("end", "switch")
            self.load_profile(entries[name], name)
            self.render_state()
            self.notify(_("Profile '{name}' loaded", name=name))

        self.push_screen(ProfileMenu(entries, self.profile), switch)

    async def action_quit(self) -> None:
        if self.mode == POMODORO and self.phase == WORK and self.running:
            self.hook("end", "quit")
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()
        self.exit()

    def hook(self, which: str, event: str) -> None:
        """which: start|end; event: start|resume (start) or end|pause|quit|switch (end)."""
        run_hook(self.hooks.get(which, ""), {
            "POMO_EVENT": event, "POMO_PROFILE": self.profile or "",
            "POMO_DONE": str(self.done_pomodoros), "POMO_CYCLES": str(self.cycles),
            "POMO_WORK_MIN": str(self.durations[WORK] // 60),
        })

    # ---- display -------------------------------------------------------
    def hint_rows(self) -> list[list[tuple[str, str, str]]]:
        """Key hints as (key, action, label), grouped by role: the timer first, then the app.
        Labels say what the key will do now (Start / Pause / Resume, the mode to switch to)."""
        stopwatch = self.mode == STOPWATCH
        idle = not self.running and (self.elapsed == 0 if stopwatch else not self.started)
        toggle = _("Start") if idle else _("Pause") if self.running else _("Resume")
        timer = [("space", "toggle", toggle),
                 ("l", "lap", _("Lap")) if stopwatch else ("n", "skip", _("Next phase")),
                 ("r", "reset", _("Reset"))]
        app = [("p", "profiles", _("Profiles")),
               ("m", "mode", _("Pomodoro") if stopwatch else _("Stopwatch")),
               ("q", "quit", _("Quit"))]
        return [[h for h in row if self.check_action(h[1], ())] for row in (timer, app)]

    def render_hints(self) -> None:
        """Render the hint rows, wrapping whole "key label" items to the terminal width."""
        width = max(self.size.width - 2, 20)  # minus the horizontal padding
        sep = "   "
        lines = []
        for row in self.hint_rows():
            line, used = [], 0
            for key, action, label in row:
                size = cell_len(f"{key} {label}")
                if line and used + len(sep) + size > width:
                    lines.append(line)
                    line, used = [], 0
                used += (len(sep) if line else 0) + size
                # the label is the clickable part: link styling would override the key color
                line.append(f"[b $accent]{key}[/] [@click=app.{action}]{label}[/]")
            lines.append(line)
        markup = "\n".join(sep.join(line) for line in lines)
        if markup != getattr(self, "_hints", None):
            self._hints = markup
            self.main_screen.query_one("#hints", Static).update(markup)

    def on_resize(self) -> None:
        if hasattr(self, "main_screen"):
            self.render_hints()

    def render_state(self) -> None:
        screen = self.main_screen
        self.render_hints()
        pomodoro = self.mode == POMODORO
        screen.query_one("#bar", ProgressBar).display = pomodoro
        screen.query_one("#laps", DataTable).display = not pomodoro and bool(self.laps)
        if pomodoro:
            self.render_pomodoro(screen)
        else:
            self.render_stopwatch(screen)

    def render_stopwatch(self, screen) -> None:
        screen.set_classes([STOPWATCH] + ([] if self.running else ["paused"]))
        state = "" if self.running else _(" (paused)")
        screen.query_one("#phase", Label).update(f"{ICONS[STOPWATCH]}  {_('Stopwatch')}{state}")
        screen.query_one("#clock", Digits).update(format_elapsed(self.elapsed))
        screen.query_one("#info", Label).update(_("Laps: {n}", n=len(self.laps)))
        secs = int(self.elapsed)
        self.write_state({"mode": STOPWATCH, "running": self.running, "elapsed": secs,
                          "laps": len(self.laps), "since": time.time()},
                         key=(STOPWATCH, self.running, len(self.laps)), tick=secs)

    def render_laps(self) -> None:
        """Lap table, newest first; fastest lap in green, slowest in red."""
        table = self.main_screen.query_one("#laps", DataTable)
        table.clear()
        splits = [t - (self.laps[i - 1] if i else 0.0) for i, t in enumerate(self.laps)]
        best = splits.index(min(splits)) if len(splits) > 1 else None
        worst = splits.index(max(splits)) if len(splits) > 1 else None
        for i in reversed(range(len(splits))):
            style = "green" if i == best else "red" if i == worst else ""
            table.add_row(str(i + 1), Text(format_elapsed(splits[i]), style=style),
                          format_elapsed(self.laps[i]))

    def render_pomodoro(self, screen) -> None:
        secs = max(0, int(self.remaining + 0.999))
        mm, ss = divmod(secs, 60)
        total = self.durations[self.phase]
        screen.set_classes([self.phase] + ([] if self.running else ["paused"]))
        state = "" if self.running else _(" (paused)")
        screen.query_one("#phase", Label).update(f"{ICONS[self.phase]}  {phase_label(self.phase)}{state}")
        screen.query_one("#clock", Digits).update(f"{mm:02d}:{ss:02d}")
        screen.query_one("#bar", ProgressBar).update(total=total, progress=total - secs)
        screen.query_one("#info", Label).update(
            (_("Profile: {name}  ·  ", name=self.profile) if self.profile else "")
            + _("Pomodoros: {done}  ·  cycle {n}/{total}", done=self.done_pomodoros,
                n=self.done_pomodoros % self.cycles + 1, total=self.cycles)
        )
        self.write_state({"mode": POMODORO, "phase": self.phase, "running": self.running,
                          "remaining": secs, "total": total, "done": self.done_pomodoros,
                          # end timestamp: waybar can count down without waiting for the TUI
                          "ends_at": time.time() + secs if self.running else None},
                         key=(self.phase, self.running, self.done_pomodoros), tick=secs)

    def write_state(self, data: dict, key: tuple, tick: int) -> None:
        """Write the waybar state file when the displayed second changes;
        signal waybar right away only when `key` (mode, phase, running...) changes."""
        old = getattr(self, "_last_state", None)
        if old != (key, tick):
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps({"pid": os.getpid(), "lang": lang, **data}))
            tmp.replace(STATE_FILE)
            if old is None or old[0] != key:
                refresh_waybar()
            self._last_state = (key, tick)


class ProfileList(OptionList):
    BINDINGS = [
        Binding("j", "cursor_down", show=False),
        Binding("k", "cursor_up", show=False),
    ]


class ProfileMenu(ModalScreen[str | None]):
    """Profile picker: returns the chosen profile name, or None if cancelled."""

    CSS = """
    ProfileMenu { align: center middle; }
    #menu { width: auto; max-width: 90%; height: auto; padding: 1 2;
            border: round $accent; background: $surface; }
    #menu-title { text-style: bold; margin-bottom: 1; }
    ProfileList { width: auto; height: auto; max-height: 20; border: none; }
    #menu-help { color: $text-muted; margin-top: 1; }
    """
    BINDINGS = [Binding("escape", "dismiss(None)", show=False)]

    def __init__(self, entries: dict[str, dict], current: str | None) -> None:
        super().__init__()
        self.entries = entries
        self.current = current

    def compose(self) -> ComposeResult:
        options = [
            Option(f"{'●' if name == self.current else ' '} {name:<12} " + _(
                "work {work} min · break {short} min · long break {long} min · {cycles} cycles",
                work=v["work"], short=v["short_break"], long=v["long_break"], cycles=v["cycles"]), id=name)
            for name, v in self.entries.items()
        ]
        with Vertical(id="menu"):
            yield Label(_("Choose a profile"), id="menu-title")
            yield ProfileList(*options)
            yield Label(_("↑↓ / j k: move · Enter: select · Esc: cancel"), id="menu-help")

    def on_mount(self) -> None:
        menu = self.query_one(ProfileList)
        names = list(self.entries)
        menu.highlighted = names.index(self.current) if self.current in names else 0
        menu.focus()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        self.dismiss(event.option.id)


# ---------------------------------------------------------------- config
DEFAULTS = {
    "work": 25, "short_break": 5, "long_break": 15, "cycles": 4,
    "on_work_start": "pomo-media resume",
    "on_work_end": "pomo-media pause",
}
INT_KEYS = ("work", "short_break", "long_break", "cycles")
HOOK_KEYS = ("on_work_start", "on_work_end")
LEGACY_KEYS = ("profils", "defaut", "commandes")


def load_config() -> dict:
    if not CONFIG_FILE.exists():
        return {}
    try:
        with CONFIG_FILE.open("rb") as f:
            cfg = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(_("error in {file}: {error}", file=CONFIG_FILE, error=e))
    if any(k in cfg for k in LEGACY_KEYS):
        raise ConfigError(_("{file} uses the old French keys (profils, defaut, commandes...): "
               "update it, see config.toml in the project", file=CONFIG_FILE))
    return cfg


def parse_values(table: dict, where: str, allowed: tuple[str, ...]) -> dict:
    for key, val in table.items():
        if key not in allowed:
            raise ConfigError(_("unknown key '{key}' in {where} (expected: {keys})",
                   key=key, where=where, keys=", ".join(allowed)))
        if key in INT_KEYS and (not isinstance(val, int) or isinstance(val, bool) or val <= 0):
            raise ConfigError(_("'{key}' must be an integer > 0 ({where})", key=key, where=where))
        if key in HOOK_KEYS and not isinstance(val, str):
            raise ConfigError(_("'{key}' must be a string ({where})", key=key, where=where))
    return dict(table)


def profile_values(profiles: dict, name: str) -> dict:
    if name not in profiles:
        raise ConfigError(_("profile '{name}' not found (available: {names})",
               name=name, names=", ".join(profiles) or _("none")))
    return parse_values(profiles[name], _("profile '{name}'", name=name), INT_KEYS + HOOK_KEYS)


def resolve_settings(cfg: dict, profile: str | None) -> dict:
    """defaults < [hooks] < profile."""
    settings = {**DEFAULTS, **parse_values(cfg.get("hooks", {}), "[hooks]", HOOK_KEYS)}
    if profile:
        settings.update(profile_values(cfg.get("profiles", {}), profile))
    return settings


def positive_int(v: str) -> int:
    n = int(v)
    if n <= 0:
        raise argparse.ArgumentTypeError(_("must be an integer > 0"))
    return n


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        description=_("Pomodoro TUI: runs commands when work starts/ends (pauses/resumes media by default)"),
        epilog=_("Config: {file}. Precedence: defaults < [hooks] < profile < CLI options. "
                 "Hooks receive POMO_EVENT (start|resume|end|pause|quit|switch), POMO_PROFILE, "
                 "POMO_DONE, POMO_CYCLES, POMO_WORK_MIN.", file=CONFIG_FILE),
    )
    ap.add_argument("-p", "--profile", help=_("profile to use (default: default_profile from the config file)"))
    ap.add_argument("-L", "--list", action="store_true", help=_("list profiles and exit"))
    ap.add_argument("-w", "--work", type=positive_int, help=_("work minutes ({default})", default=DEFAULTS["work"]))
    ap.add_argument("-s", "--short-break", type=positive_int,
                    help=_("short break minutes ({default})", default=DEFAULTS["short_break"]))
    ap.add_argument("-l", "--long-break", type=positive_int,
                    help=_("long break minutes ({default})", default=DEFAULTS["long_break"]))
    ap.add_argument("-c", "--cycles", type=positive_int,
                    help=_("work sessions before the long break ({default})", default=DEFAULTS["cycles"]))
    ap.add_argument("--on-work-start", metavar="CMD",
                    help=_("command run when work starts (\"{default}\")", default=DEFAULTS["on_work_start"]))
    ap.add_argument("--on-work-end", metavar="CMD",
                    help=_("command run when work ends (\"{default}\")", default=DEFAULTS["on_work_end"]))
    ap.add_argument("--no-hooks", action="store_true", help=_("do not run any hook"))
    ap.add_argument("--stopwatch", action="store_true", help=_("start in stopwatch mode"))
    ap.add_argument("--lang", choices=("auto", *LANGUAGES),
                    help=_("UI language: {langs} (default: auto)", langs=", ".join(LANGUAGES)))
    return ap


def main() -> None:
    global lang
    # The language must be known before building translated help texts.
    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--lang")
    cli_lang = pre.parse_known_args()[0].lang
    lang = resolve_language(cli_lang, os.environ.get("POMO_LANG"))
    try:
        cfg = load_config()
    except ConfigError as e:
        fail(str(e))
    lang = resolve_language(cli_lang, os.environ.get("POMO_LANG"), cfg.get("language"))

    args = build_parser().parse_args()
    try:
        run(args, cfg)
    except ConfigError as e:
        fail(str(e))


def run(args: argparse.Namespace, cfg: dict) -> None:
    profiles, default_profile = cfg.get("profiles", {}), cfg.get("default_profile")

    if args.list:
        if not profiles:
            print(_("No profiles ({file})", file=CONFIG_FILE))
        for name in profiles:
            v = resolve_settings(cfg, name)
            mark = "*" if name == default_profile else " "
            print(f"{mark} {name:<12} " + _(
                "work {work} min · break {short} min · long break {long} min · {cycles} cycles",
                work=v["work"], short=v["short_break"], long=v["long_break"], cycles=v["cycles"]))
            print(f"  {'':<12} " + _("start: {start}  ·  end: {end}",
                                     start=v["on_work_start"] or _("(nothing)"),
                                     end=v["on_work_end"] or _("(nothing)")))
        return

    name = args.profile or default_profile
    settings = resolve_settings(cfg, name)
    for key in DEFAULTS:  # explicit CLI options win
        if getattr(args, key) is not None:
            settings[key] = getattr(args, key)

    try:
        Pomo(settings, name, args.no_hooks, STOPWATCH if args.stopwatch else POMODORO).run()
    finally:
        STATE_FILE.unlink(missing_ok=True)
        refresh_waybar()


if __name__ == "__main__":
    main()
